Public Sub btnStressCPU_Click()
  $iInEsecuzione = 1
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sComando As String
  
  If Exist(sConfFile) Then Try sPassword = FromBase64$(File.Load(sConfFile))
  If sPassword = "" Then
    Message.Warning("Manca la password di root salvata nelle impostazioni.")
    Return
  Endif
  
  ' Controlla se c'è già un processo attivo
  If hProcess Then
    If hProcess.State = Process.Running Then
      Message.Warning("C'è già un test in esecuzione!")
      Return
    Endif
  Endif
  
  txtReportStress.Clear
  txtReportStress.Text = "--- STRESS TEST CPU IN CORSO ---\n"
