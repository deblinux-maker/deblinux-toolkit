Public Sub hProcess_Kill()
  txtReportStress.Text &= "\n\n--- PROCESSO FINITO CORRETTAMENTE ---"
  hProcess = Null
End Sub

Public Sub TimerStress_Timer()
  ' Controlla se il processo è ancora attivo
  If hProcess.State = Process.Running Then 
    ' Il processo sta ancora girando, non facciamo nulla e lasciamo che il timer continui
    Return
  Else
    ' Il processo è finito!
    TimerStress.Stop
    
    ' Leggiamo il risultato dal log
    Dim sRisultato As String = File.Load(sFileLog)
    
    ' Mostriamo il risultato all'utente
    txtReportStress.Text = "--- TEST COMPLETATO ---\n" & sRisultato
    Message.Info("Il test è terminato.")
  Endif
End
