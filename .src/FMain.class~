  ' Eseguiamo il comando
  Shell "pkexec /usr/sbin/smartctl -i /dev/" & sDev To sOut
  
  ' Dividiamo l'output per righe
  aRighe = Split(sOut, "\n")
  
  ' Filtriamo solo le righe che contengono dati essenziali
  For Each sRiga In aRighe
    If InStr(sRiga, "Model:") Or InStr(sRiga, "Serial Number:") Or InStr(sRiga, "Firmware Version:") Or InStr(sRiga, "Capacity:") Or InStr(sRiga, "Rotation Rate:") Or InStr(sRiga, "TRIM Command:") Then
       sRisultatoFiltrato &= Trim(sRiga) & "\n"
    Endif
  Next
  
  Return sRisultatoFiltrato
End
Public Function GetTrimStatus() As String
  Dim sOut As String
  ' Cerchiamo lo stato del timer di sistema
  Shell "systemctl status fstrim.timer | grep -E 'Active:|Trigger:'" To sOut
  
  If Not sOut Then Return "TRIM non configurato."
  
  ' Rendiamo l'output leggibile
  sOut = Replace(sOut, "Active:", "Stato:")
  sOut = Replace(sOut, "Trigger:", "Prossima esecuzione:")
  
  Return Trim(sOut)
End
Public Function GetUsuraDisco(sDev As String) As String
  Dim sOut As String
  Dim aRighe As String[]
  Dim sRiga As String
  Dim aParole As String[]
  
  ' Eseguiamo smartctl -A (attributi)
  Shell "pkexec /usr/sbin/smartctl -A /dev/" & sDev To sOut
  
  aRighe = Split(sOut, "\n")
  For Each sRiga In aRighe
    ' Cerchiamo la riga che contiene l'attributo 241 (standard per SSD)
    If InStr(sRiga, "241 Total_LBAs_Written") Then
      ' Dividiamo la riga in parole (usa lo spazio come separatore)
      aParole = Split(Trim(sRiga), " ")
      ' L'ultimo valore della riga solitamente è il numero grezzo dei LBAs
      Return "Scritture Totali: " & aParole[aParole.Max]
    Endif
  Next
  
  Return "Dato non disponibile"
End
