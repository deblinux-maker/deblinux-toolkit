Public Sub AggiornaStatisticheSwap()
  Dim sLine As String
  Dim lSwapTotal As Long = 0
  Dim lSwapFree As Long = 0
  Dim lSwapUsed As Long
  Dim aParts As String[]
  
  If Exist("/proc/meminfo") Then
    For Each sLine In Split(File.Load("/proc/meminfo"), "\n")
      If sLine Begins "SwapTotal:" Then
        aParts = Split(Trim(sLine), " ", "", True)
        If aParts.Count >= 2 Then lSwapTotal = Val(aParts[1])
      Else If sLine Begins "SwapFree:" Then
        aParts = Split(Trim(sLine), " ", "", True)
        If aParts.Count >= 2 Then lSwapFree = Val(aParts[1])
      End If
    Next
    
    If lSwapTotal > 0 Then
      lSwapUsed = lSwapTotal - lSwapFree
      PercentSwap = lSwapUsed / lSwapTotal
    Else
      PercentSwap = 0.0
    End If
    
    DrawingArea1.Refresh()
  End If
  
End Sub

