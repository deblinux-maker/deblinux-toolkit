Public Sub CaricaHardwareENetwork()
  Dim sOut As String
  
  ' --- 1. POPOLA HARDWARE (txtHardware) ---
  ' Usiamo una variabile temporanea per costruire il testo, è più efficiente
  Dim sHardware As String
  
  sOut = EseguiComando("lscpu | grep 'Model name' | cut -d':' -f2 | xargs")
  sHardware = "CPU: " & IIf(sOut = "", "N/D", sOut) & "\n"
  
