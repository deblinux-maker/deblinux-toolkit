Public Sub ProcPulizia_Read()
  Dim sBuffer As String
  
  Try Read #hProc, sBuffer, -2048
  If Error Then Return
  
  txtLog.Insert(sBuffer)
  txtLog.Pos = Len(txtLog.Text)
  
  ' Fai avanzare la barra gradualmente mentre il processo Root è in corso
  If ProgressBar1.Value < 0.95 Then  
     ProgressBar1.Value += 0.01  
  Endif
  
  ' Se il log contiene il nostro segnale, abbiamo finito
  If InStr(sBuffer, "FINE_OPERAZIONI") > 0 Then
     txtLog.Text = Replace(txtLog.Text, "FINE_OPERAZIONI", "")
     ProgressBar1.Value = 1.0  
     If hProc Then hProc.Close
     PuliziaTerminata()
  Endif
End
