  Dim sLinee As String[]
  Dim sRiga As String
  Dim sCampi As String[]
  Dim sNomeCartella As String
  Dim sData As String
  Dim sDimensione As String
  Dim iTotaleRighe As Integer
  Dim iRiga As Integer
  
  If cmbElencoDischi.Index < 0 Then
    Message.Warning("Seleziona prima un disco dalla lista!")
    Return
  Endif
  
  sSelezione = cmbElencoDischi.Text
  sDevice = Trim(Split(sSelezione, " ")[0])
  
  Shell "lsblk -n -o MOUNTPOINT " & sDevice & " | grep -v '^$' | head -n 1" To sPuntoMount
  sPuntoMount = Trim(sPuntoMount)
  
  If sPuntoMount = "" Then
    Shell "lsblk -n -o MOUNTPOINT " & sDevice & "1 2>/dev/null | grep -v '^$' | head -n 1" To sPuntoMount
    sPuntoMount = Trim(sPuntoMount)
  Endif
  
  If sPuntoMount = "" Then
    Message.Error("Il disco o partizione " & sDevice & " non risulta montato nel sistema!")
    Return
  Endif
  
  sPuntoMountCorrente = sPuntoMount
  
  ' Eseguiamo il comando rapido
  sComando = "ls -l --time-style=+%d/%m/%Y " & Shell(sPuntoMount) & " | grep '^d'"
  Shell sComando To sOutput
  
  sLinee = Split(sOutput, "\n")
  
  ' 1. Prima di tutto, contiamo quante righe valide abbiamo nel sistema
  iTotaleRighe = 0
  For Each sRiga In sLinee
    If Trim(sRiga) = "" Then Continue
    While InStr(sRiga, "  ") > 0
      sRiga = Replace(sRiga, "  ", " ")
    Wend
    sCampi = Split(Trim(sRiga), " ")
    If sCampi.Count >= 7 Then iTotaleRighe += 1
  Next
  
  ' 2. Ora configuriamo la GridView disattivando l'intestazione nativa
  GridViewSpazio.Header = GridView.None
  
  ' 3. Impostiamo il totale delle righe aggiungendo +1 per fare spazio alla finta intestazione
  GridViewSpazio.Rows.Count = iTotaleRighe + 1
  
  ' 4. Impostiamo le larghezze delle colonne
  GridViewSpazio.Columns.Count = 3
  GridViewSpazio.Columns[0].Width = 170
  GridViewSpazio.Columns[1].Width = 170
  GridViewSpazio.Columns[2].Width = 140
  
  ' 5. Scriviamo i titoli nella riga 0 (la prima in alto)
  GridViewSpazio[0, 0].Text = ("📂 Nome Cartella")
  GridViewSpazio[0, 1].Text = ("📊 Dimensione Base")
  GridViewSpazio[0, 2].Text = ("📅 Ultima Modifica")
  
  ' Formattazione dell'intestazione (eseguita una sola volta)
  GridViewSpazio[0, 0].Font.Bold = True
  GridViewSpazio[0, 1].Font.Bold = True
  GridViewSpazio[0, 2].Font.Bold = True
  
  GridViewSpazio[0, 0].Background = Color.DarkGray
  GridViewSpazio[0, 1].Background = Color.DarkGray
  GridViewSpazio[0, 2].Background = Color.DarkGray
  
  ' 6. Inseriamo i dati reali a partire dalla riga 1 in poi
  iRiga = 1
  For Each sRiga In sLinee
    If Trim(sRiga) = "" Then Continue
    
    While InStr(sRiga, "  ") > 0
      sRiga = Replace(sRiga, "  ", " ")
    Wend
    
    sCampi = Split(Trim(sRiga), " ")
    
    If sCampi.Count >= 7 Then
      sDimensione = sCampi[4] & " B"
      sData = sCampi[5]
      
      sNomeCartella = ""
      For i As Integer = 6 To sCampi.Max
        sNomeCartella &= sCampi[i] & " "
      Next
      sNomeCartella = Trim(sNomeCartella)
      
      ' Scriviamo nelle celle della GridView partendo dalla riga 1
      GridViewSpazio[iRiga, 0].Text = "📁 " & sNomeCartella
      GridViewSpazio[iRiga, 1].Text = sDimensione
      GridViewSpazio[iRiga, 2].Text = sData
      
      iRiga += 1
    Endif
  Next

End
