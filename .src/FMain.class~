Public Sub CaricaGovernorCPU()
  Dim sPercorso As String = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors"
  Dim sContenuto As String
  Dim sGovernor As String
  
  ' Pulisce la ComboBox prima di riempirla
  cmbCpuGov.Clear()
  
  ' Controlla se il file esiste sul sistema (supportato dalla CPU)
  If Exist(sPercorso) Then
    sContenuto = Trim(File.Load(sPercorso))
    
    ' I governor sono separati da spazi, quindi li separiamo
    For Each sGovernor In Split(sContenuto, " ")
      If sGovernor Then cmbCpuGov.Add(sGovernor)
    Next
    
    ' Seleziona il primo per comodità o imposta quello attuale
    If cmbCpuGov.Count > 0 Then cmbCpuGov.Index = 0
  Else
    ' Fallimento o CPU non supportata (es. macchine virtuali senza scaling)
    cmbCpuGov.Add("Non disponibile")
    cmbCpuGov.Enabled = False
  End If

  ' Legge anche il governor attualmente in uso per mostrarlo
  Dim sCorrente As String = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
  If Exist(sCorrente) Then
    cmbCpuGov.Text = Trim(File.Load(sCorrente))
  End If

End Sub

Public Sub CaricaSwappiness()
  Dim sPercorso As String = "/proc/sys/vm/swappiness"
  Dim sValore As String
  Dim bZramAttivo As Boolean
  
  If Exist(sPercorso) Then
    sValore = Trim(File.Load(sPercorso))
    
    ' Imposta il valore sullo Slider
    SliderSwap.Value = CInt(sValore)
    
    ' Controlla se zram è attivo nel sistema
    If Exist("/dev/zram0") Then
      bZramAttivo = True
    Else
      bZramAttivo = False
    End If
    
    ' Aggiorna l'etichetta corretta (LblSwap) in base allo stato reale
    If bZramAttivo Then
      LblSwap.Text = ("Valore attuale: ") & sValore & " (Consigliato con ZRAM: 100 ✅ Nessun danno al disco)"
    Else
      LblSwap.Text = ("Valore attuale: ") & sValore & " (Consigliato: 60)"
    End If
    
  End If

End Sub

Public Sub InizializzaKernelPrestazioni()
  Dim sPercorsoGov As String = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors"
  Dim sPercorsoCorrente As String = "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
  Dim sPercorsoSwap As String = "/proc/sys/vm/swappiness"
  Dim sContenuto As String
  Dim sGov As String
  Dim bZramAttivo As Boolean
  
  ' --- 1. POPOLA GOVERNOR CPU ---
  cmbCpuGov.Clear()
  If Exist(sPercorsoGov) Then
    sContenuto = Trim(File.Load(sPercorsoGov))
    For Each sGov In Split(sContenuto, " ")
      If sGov Then cmbCpuGov.Add(sGov)
    Next
  Else
    cmbCpuGov.Add("performance")
    cmbCpuGov.Add("schedutil")
  End If
  
  If Exist(sPercorsoCorrente) Then
    cmbCpuGov.Text = Trim(File.Load(sPercorsoCorrente))
  End If
  
  ' --- 2. LEGGI SWAPPINESS ATTUALE CON SUPPORTO ZRAM ---
  If Exist(sPercorsoSwap) Then
    Dim iSwapVal As Integer = CInt(Trim(File.Load(sPercorsoSwap)))
    SliderSwap.Value = iSwapVal
    
    ' Controlla se zram è attivo
    If Exist("/dev/zram0") Then
      bZramAttivo = True
    Else
      bZramAttivo = False
    End If
    
    ' Aggiorna l'etichetta in base allo stato reale
    If bZramAttivo Then
      LblSwap.Text = ("Valore attuale: ") & iSwapVal & " (Consigliato con ZRAM: 100 ✅ Nessun danno al disco)"
    Else
      LblSwap.Text = ("Valore attuale: ") & iSwapVal & " (Consigliato: 60)"
    End If
    
  Else
    SliderSwap.Value = 60
    LblSwap.Text = ("Valore attuale: 60 (Consigliato: 60)")
  End If

End Sub
