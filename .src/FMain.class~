Public Sub btnCheckIntegrita_Click()
  Dim hProc As Process
  Dim sOutput As String
  Dim sCmd As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo la password di amministrazione
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza, è necessario salvare prima la password di root nelle impostazioni generali.")
    Return
  Endif

  panel2.Enabled = False
  btnCheckIntegrita.Enabled = False
  txtLog.Clear
  txtLog.Insert("[FIXER] Verifica integrità in corso (con privilegi di root)...\n")
  
  ' 2. Comando apt-get check eseguito con sudo -S
  sCmd = "apt-get check 2>&1"
  
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sCmd)] For Read As "ProcCheck"
  
  If Error Or If Not hProc Then
    Message.Error("Impossibile avviare il controllo: " & Error.Text)
    btnCheckIntegrita.Enabled = True
    panel2.Enabled = True
    Return
  Endif

  While hProc.State = Process.Running
    If Not Eof(hProc) Then
      Dim sBuffer As String
      Read #hProc, sBuffer, -2048
      sOutput &= sBuffer
      txtLog.Insert(sBuffer)
      txtLog.EnsureVisible
    Endif
    Wait 0.05
  Wend
  
  ' 3. Analisi intelligente basata sia sul codice d'uscita (hProc.Value) sia sui testi
  If hProc.Value = 0 And InStr(LCase(sOutput), "e:") = 0 And InStr(LCase(sOutput), "error") = 0 Then
     txtLog.Insert("\n[FIXER] Verifica terminata: Sistema integro!\n")
     Message.Info("Nessun problema rilevato. Il database dei pacchetti è a posto.")
  Else
     txtLog.Insert("\n[FIXER] Attenzione: Rilevati errori o problemi di integrità.\n")
     Message.Error("Sono stati rilevati errori durante la verifica del sistema.")
  Endif
  
  btnCheckIntegrita.Enabled = True
  panel2.Enabled = True
End

Public Sub btnDisabilita_Click()
  Dim sNomeFile As String
  Dim sPathOrigine As String
  Dim sDirDisabled As String = User.Home &/ ".config/autostart/disabled/"
  
  If gvStartup.Row < 0 Then Return
  
  If gvStartup[gvStartup.Row, 1].Text = "Disabilitato" Then 
    Message.Info("Questa applicazione è già disabilitata.")
    Return
  Endif
  
  ' Recuperiamo il nome file esatto dal Tag
  sNomeFile = gvStartup[gvStartup.Row, 0].Tag
  sPathOrigine = User.Home &/ ".config/autostart/" & sNomeFile
  
  If Not Exist(sPathOrigine) Then
    Message.Error("File non trovato: " & sPathOrigine)
    Return
  Endif
  
  If Not Exist(sDirDisabled) Then Mkdir sDirDisabled
  
  Try Move sPathOrigine To sDirDisabled & sNomeFile
  
  If Error Then
    Message.Error("Impossibile spostare il file: " & Error.Text)
  Else
    CaricaStartup()
  Endif
End
