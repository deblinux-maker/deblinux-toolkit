Public Sub DisinstallaApt()
  Dim i As Integer
  Dim iCount As Integer = 0
  Dim sMsg As String
  Dim hProc As Process
  Dim sBuffer As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sAptCmd As String

  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Array temporaneo per raccogliere i nomi dei pacchetti selezionati
  Dim aPacchetti As New String[]

  ' 3. Controlliamo la griglia e aggiungiamo ogni pacchetto selezionato
  For i = 0 To GridViewApt.Rows.Count - 1
    If GridViewApt.Rows[i].Selected Then
      aPacchetti.Add(GridViewApt[i, 0].Text)
      iCount += 1
    Endif
  Next

  ' Verifica se c'è qualcosa da fare
  If iCount = 0 Then
    Message.Info("Nessun pacchetto APT selezionato.")
    Return
  Endif

  ' 4. Messaggio di conferma dinamico
  If iCount = 1 Then
    sMsg = "Vuoi disinstallare 1 pacchetto APT?"
  Else
    sMsg = "Vuoi disinstallare " & iCount & " pacchetti APT?"
  Endif

  If Message.Question(sMsg, "Sì", "No") <> 1 Then Return

  ' 5. Reset log
  TxtLog.Clear
  TxtLog.Text = "Rimozione di " & iCount & " pacchetti in corso...\n"

  ' 6. Creazione del comando di disinstallazione
  sAptCmd = "apt-get remove -y " & aPacchetti.Join(" ")

  ' 7. Esecuzione sicura sfruttando la password salvata (tramite sudo -S)
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sAptCmd)] For Read As "ProcessoDisinstalla"

  If Error Or If Not hProc Then
    Message.Error("Impossibile avviare il processo di disinstallazione.")
    Return
  Endif

  ' 8. Ciclo in tempo reale per leggere l'output nel log
  While hProc.State = Process.Running
    If Not Eof(hProc) Then
      Read #hProc, sBuffer, -2048
      TxtLog.Insert(sBuffer)
      TxtLog.EnsureVisible
    Endif
    Wait 0.05
   Wend

  ' 9. Controllo del risultato finale
  If hProc.Value = 0 Then
    TxtLog.Insert("\n[OK] Disinstallazione completata con successo!\n")
    Message.Info("Pacchetti disinstallati con successo!")
    ' Ricarica la lista aggiornata dei pacchetti
    CaricaPacchettiApt()
  Else
    TxtLog.Insert("\n[ERRORE] Disinstallazione fallita o interrotta.\n")
    Message.Error("La disinstallazione ha riscontrato un errore.")
  Endif
End

