End

Public Sub ImpostaSliderZram()
  Dim sDati As String
  Dim sRiga As String
  Dim sSoloNumeri As String = ""
  Dim i As Integer
  Dim iRamTotaleKB As Long

  If Exist("/proc/meminfo") Then
    sDati = File.Load("/proc/meminfo")
    sRiga = Split(sDati, "\n")[0]
    
    ' Estrazione numeri pulita
    For i = 1 To Len(sRiga)
      If IsDigit(Mid(sRiga, i, 1)) Then 
        sSoloNumeri &= Mid(sRiga, i, 1)
      Endif
    Next
    
    iRamTotaleKB = Val(sSoloNumeri)
    iRamSistemaMB = Round(iRamTotaleKB / 1024, 0)

    ' Fallback di sicurezza se la lettura fallisce o restituisce valori assurdi
    If iRamSistemaMB < 256 Then iRamSistemaMB = 2048

    ' Configurazione Slider hardware
    sldZramSize.MaxValue = iRamSistemaMB 
    sldZramSize.MinValue = 256
    sldZramSize.Value = Round(iRamSistemaMB / 2, 0)
    
    ' Scrittura interfaccia grafica
    lblZramMax.Text = sldZramSize.MaxValue & " MB"
    lblZramMin.Text = sldZramSize.MinValue & " MB"
    lblSldValue.Text = sldZramSize.Value & " MB"
    
    lblZramMax.Refresh
    lblZramMin.Refresh
    lblSldValue.Refresh
  Endif
End
Public Sub btnToggleZram_Click()
  Dim sCmd As String
  Dim iSize As Integer = sldZramSize.Value 
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif
  
  bInTransizione = True
  Me.Mouse = Mouse.Wait
  btnToggleZram.Enabled = False  

  If btnToggleZram.Text = "Attiva zRAM" Then
    ' Attivazione zRAM + creazione del servizio systemd per mantenerla attiva al riavvio
    sCmd = "modprobe zram && zramctl --reset /dev/zram0 2>/dev/null || true && " & 
           "zramctl --find --size " & iSize & "M && " & 
           "mkswap /dev/zram0 && swapon /dev/zram0 -p 100 && " &
           "printf '[Unit]\nDescription=Attiva zRAM al boot\nAfter=local-fs.target\n\n[Service]\nType=oneshot\nExecStart=/sbin/modprobe zram\nExecStart=/usr/bin/zramctl --find --size " & iSize & "M\nExecStart=/sbin/mkswap /dev/zram0\nExecStart=/sbin/swapon /dev/zram0 -p 100\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/zram-init.service && " &
           "systemctl enable zram-init.service"
    
    Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sCmd)) Wait
    
    Wait 0.5
    
    If Not Exist("/sys/block/zram0") Then  
        Message.Error("Impossibile attivare la zRAM.")
    Else
        btnToggleZram.Text = "Disattiva zRAM"
        btnToggleZram.Foreground = Color.Red
        sldZramSize.Enabled = False   
        bZramRichiestaAttiva = True  
    Endif
    
  Else
    ' Logica di disattivazione + rimozione del servizio systemd dal boot
    sCmd = "swapoff /dev/zram0 2>/dev/null; sleep 0.5; " &
           "zramctl --reset /dev/zram0 2>/dev/null; " &
           "modprobe -r zram 2>/dev/null; " &
           "systemctl disable zram-init.service 2>/dev/null; " &
           "rm -f /etc/systemd/system/zram-init.service 2>/dev/null"
    
    Me.Refresh()
    Wait 0.1
    
    Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sCmd)) Wait
    
    ' Ciclo di attesa intelligente per dare tempo al kernel di liberare zram0
    Dim iTentativi As Integer = 0
    While Exist("/sys/block/zram0") And iTentativi < 5
        Wait 0.5
        Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- zramctl --reset /dev/zram0 2>/dev/null") Wait
        Inc iTentativi
    Wend

    ' Controllo finale reale dopo i tentativi
    If Exist("/sys/block/zram0") Then
        Message.Error("Errore critico: il dispositivo zram0 risulta ancora occupato.")
    Else
        btnToggleZram.Text = "Attiva zRAM"
        btnToggleZram.Foreground = Color.Default
        sldZramSize.Enabled = True   
        bZramRichiestaAttiva = False
    Endif
  Endif

  ' Pulizia finale
  bInTransizione = False
  btnToggleZram.Enabled = True
  Me.Mouse = Mouse.Default
  
  LeggiZramDaProc()
  ProgressBarZram.Refresh()  
End
Public Sub btnAutoConfig_Click()
  Dim iSuggerito As Integer
  Dim sCmd As String
  Dim sLogFile As String = User.Home & "/zram_error.log"
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sAlgoritmo As String = "zstd" ' Usiamo zstd come standard automatico avanzato

  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Calcolo ottimizzato (metà RAM, arrotondato)
  iSuggerito = Round((iRamSistemaMB * 0.5) / 256) * 256
  If iSuggerito < 256 Then iSuggerito = 256
  
  ' 3. Pulisci il vecchio log prima di iniziare
  If Exist(sLogFile) Then Kill sLogFile

  Me.Mouse = Mouse.Wait
  
  ' 4. Comando automatico: prova zstd, se fallisce usa lz4 + persistenza systemd
  sCmd = "modprobe zram; " &  
         "swapoff /dev/zram0 2>/dev/null; " &  
         "zramctl --reset /dev/zram0 2>/dev/null; " &  
         "zramctl --find --size " & iSuggerito & "M --algorithm " & sAlgoritmo & " 2>>" & sLogFile & " || " &
         "zramctl --find --size " & iSuggerito & "M --algorithm lz4 2>>" & sLogFile & "; " &  
         "mkswap /dev/zram0 2>>" & sLogFile & "; " &  
         "swapon -p 100 /dev/zram0 2>>" & sLogFile & " && " &
         "printf '[Unit]\nDescription=Attiva zRAM al boot\nAfter=local-fs.target\n\n[Service]\nType=oneshot\nExecStart=/sbin/modprobe zram\nExecStart=/usr/bin/zramctl --find --size " & iSuggerito & "M --algorithm " & sAlgoritmo & "\nExecStart=/sbin/mkswap /dev/zram0\nExecStart=/sbin/swapon /dev/zram0 -p 100\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/zram-init.service && " &
         "systemctl enable zram-init.service"
  
  ' Esecuzione tramite la password salvata (tramite sudo -S)
  Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sCmd)) Wait
  
  ' 5. Attesa verifica
  Wait 0.5
  
  ' 6. Controllo esito
  If Not Exist("/sys/block/zram0") Then
     Dim sErrore As String = IIf(Exist(sLogFile), File.Load(sLogFile), "Nessun dettaglio disponibile.")
     Me.Mouse = Mouse.Default
     Message.Error("Ottimizzazione fallita:\n" & sErrore)
     Return
  Endif

  ' 7. Successo
  bZramRichiestaAttiva = True
  Me.Mouse = Mouse.Default
  
  LeggiZramDaProc()
  Message.Info("Ottimizzazione completata!")
  
  ' Aggiorna interfaccia
  If TxtLog Then TxtLog.Text &= "zRAM configurata automaticamente a " & iSuggerito & " MB\n"
  btnToggleZram.Text = "Disattiva zRAM"
  btnToggleZram.Foreground = Color.White
  sldZramSize.Enabled = False
End
