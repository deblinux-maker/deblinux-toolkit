Public Sub btnSalvaPass_Click()
  Dim sDir As String = User.Home &/ ".config/deblinux_toolkit"
  Dim sConfFile As String = sDir &/ "config.conf"
  Dim sPassToSave As String = Trim(txtPassword.Text)
  Dim sOutput As String
  
  ' Controlliamo che non sia vuota
  If sPassToSave = "" Then
    Message.Warning("Inserisci una password valida prima di salvare.")
    Return
  Endif
  
  ' Verifichiamo la password catturando l'output della shell
  Shell "sudo -k; echo " & Shell(sPassToSave) & " | sudo -S true 2>&1" To sOutput
  
  If InStr(LCase$(sOutput), "sorry") > 0 Or InStr(LCase$(sOutput), "incorrect") > 0 Or InStr(LCase$(sOutput), "failure") > 0 Then
    Message.Error("La password inserita non è corretta! Verifica e riprova.")
    Return
  Endif
  
  ' Se la cartella di configurazione non esiste, la creiamo
  If Not Exist(sDir) Then
    Try Mkdir sDir
  Endif
  
  ' --- CIFRATURA BASE64 ---
  ' Convertiamo la password in Base64 prima di salvarla
  Dim sEncoded As String = Base64$(sPassToSave)
  
  ' Salviamo la stringa codificata nel file di configurazione
  Try File.Save(sConfFile, sEncoded)
  
  If Error Then
    Message.Error("Errore durante il salvataggio della password.")
  Else
    Message.Info("Password salvata e protetta con successo!")
  Endif
  AggiornaStatoPassword()
End
