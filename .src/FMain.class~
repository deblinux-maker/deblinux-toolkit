Public Sub btnTrimSSD_Click()
  Dim sDiscoRoot As String
  Dim sRota As String
  Dim bGiaAttivo As Boolean
  Dim iRisposta As Integer
  Dim sComando As String
  Dim sDataCreazione As String
  Dim sDataUltima As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sErroreOutput As String

  ' 1. Verifichiamo se la password è salvata prima di tutto
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nSalva prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Identificazione del disco di sistema
  Shell "df / | tail -n 1 | awk '{print $1}' | sed 's|^/dev/||;s|[0-9]||g'" To sDiscoRoot
  sDiscoRoot = Trim(sDiscoRoot)

  If sDiscoRoot = "" Then
    Message.Error("Errore: impossibile identificare il disco di sistema.")
    Return
  Endif

  ' 3. Verifica se è SSD o HDD
  Try Shell "cat /sys/block/" & sDiscoRoot & "/queue/rotational" To sRota
  sRota = Trim(sRota)

  If sRota <> "0" Then
    Message.Warning("Il disco di sistema (" & sDiscoRoot & ") è un Hard Disk meccanico (HDD). La funzione TRIM non è applicabile.")
    Return
  Endif

  ' --- AVVISO PREVENTIVO PER L'UTENTE ---
  iRisposta = Message.Question("Stai per avviare l'ottimizzazione TRIM del disco di sistema.\n\nSu computer datati o se è la prima volta, l'operazione potrebbe richiedere qualche secondo. Vuoi procedere?", "Procedi", "Annulla")
  If iRisposta = 2 Then Return

  ' --- PULIZIA GRAFICA ANTI- OMBRA ---
  Me.Mouse = Mouse.Wait
  txtLogPerformance.Text = "Esecuzione TRIM in corso, attendere..."
  Me.Refresh 
  Wait 0.1
  Me.Refresh
  Wait 0.1
  Wait 0.2
  
  btnTrimSSD.Enabled = False
  
  ' --- ESECUZIONE TRIM ---
  Shell "echo " & Shell$(sPassword) & " | sudo -S fstrim -v /" To sErroreOutput
  
  ' Verifica se l'operazione è andata a buon fine
  If InStr(sErroreOutput, "trimmed") > 0 Or InStr(sErroreOutput, "MiB") > 0 Then
    bGiaAttivo = Exist("/etc/cron.weekly/deblinux-trim")
    
    txtLogPerformance.Text = "TRIM eseguito correttamente!\n" & Trim(sErroreOutput)

    If bGiaAttivo Then
      Shell "stat -c %y /etc/cron.weekly/deblinux-trim | cut -d' ' -f1" To sDataCreazione
      txtLogPerformance.Text &= "\nManutenzione automatica settimanale: ATTIVA (dal " & Trim(sDataCreazione) & ")"
    Else
      txtLogPerformance.Text &= "\nManutenzione automatica settimanale: DISATTIVA"
    Endif

    If Exist("/var/log/deblinux-trim.log") Then
      Shell "head -n 1 /var/log/deblinux-trim.log" To sDataUltima
      txtLogPerformance.Text &= "\nUltima esecuzione registrata: " & Trim(sDataUltima)
    Endif

    Me.Mouse = Mouse.Default

    ' Gestione Toggle (Attiva / Disattiva automazione)
    If bGiaAttivo Then
      iRisposta = Message.Question("La manutenzione automatica settimanale è ATTIVA.\n\nVuoi DISATTIVARLA?", "Disattiva", "Lascia attiva")
      If iRisposta = 1 Then
        Shell "echo " & Shell$(sPassword) & " | sudo -S rm /etc/cron.weekly/deblinux-trim"
        txtLogPerformance.Text &= "\n\nManutenzione automatica disattivata con successo."
      Endif
    Else
      iRisposta = Message.Question("La manutenzione automatica settimanale è DISATTIVA.\n\nVuoi ATTIVARLA? (Verrà eseguita ogni settimana in background)", "Attiva", "Lascia disattiva")
      If iRisposta = 1 Then
        sComando = "echo -e '#!/bin/sh\ndate > /var/log/deblinux-trim.log\nfstrim -v / >> /var/log/deblinux-trim.log 2>&1' | tee /etc/cron.weekly/deblinux-trim > /dev/null && chmod +x /etc/cron.weekly/deblinux-trim"
        
        Shell "echo " & Shell$(sPassword) & " | sudo -S sh -c " & Shell$(sComando) To sErroreOutput
        
        If InStr(sErroreOutput, "password") = 0 Then
          txtLogPerformance.Text &= "\n\nManutenzione automatica attivata con successo."
        Else
          txtLogPerformance.Text &= "\n\nErrore attivazione automazione."
        Endif
      Endif
    Endif

  Else
    txtLogPerformance.Text = "Errore esecuzione TRIM.\nDettagli: " & Trim(sErroreOutput)
  Endif

  Me.Mouse = Mouse.Default
  btnTrimSSD.Enabled = True

End
Public Sub EseguiOttimizzazioneCompleta()
  Dim iScelta As Integer
  Dim sRamTotale As String
  Dim iRam As Integer
  Dim iSwappinessConsigliata As Integer
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sComando As String
  Dim sOutputComandi As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  iScelta = Message.Question("Questo processo eseguirà:\n\n" &  
                             "- Ottimizzazione Swappiness\n" &  
                             "- Pulizia cache APT e file temporanei\n" &  
                             "- Manutenzione SSD (TRIM)\n\n" &  
                             "Vuoi procedere?", "Avvia", "Annulla")
                             
  If iScelta = 1 Then
    ' Forziamo la pulizia visiva immediata della finestra principale
    Me.Mouse = Mouse.Wait
    txtLogPerformance.Text = "Avvio procedura di ottimizzazione totale, attendere..."
    
    ' Due passaggi di attesa ed eventi per dare tempo al Window Manager di cancellare l'ombra
    Me.Refresh
    Wait 0.1
    Me.Refresh
    Wait 0.1
    
    ' 2. Calcoliamo la swappiness ideale in base alla RAM
    Shell "free -m | grep Mem | awk '{print $2}'" To sRamTotale
    iRam = Val(Trim(sRamTotale))
    
    If iRam >= 8000 Then
      iSwappinessConsigliata = 10
    Else If iRam >= 4000 Then
      iSwappinessConsigliata = 30
    Else
      iSwappinessConsigliata = 60
    Endif

    ' Secondo messaggio pulito nel log
    txtLogPerformance.Text &= "\nEsecuzione comandi di sistema in corso (pulizia, TRIM, swappiness)..."
    Me.Refresh

    ' 3. Creazione del comando unificato
    sComando = "apt-get autoremove -y && apt-get clean && fstrim -av && sysctl vm.swappiness=" & iSwappinessConsigliata & " && echo 'vm.swappiness=" & iSwappinessConsigliata & "' | tee /etc/sysctl.d/99-deblinux-swappiness.conf > /dev/null"

    ' Esecuzione catturando l'output in una variabile silenziosa
    Shell "echo " & Shell$(sPassword) & " | sudo -S sh -c " & Shell$(sComando) To sOutputComandi

    Me.Mouse = Mouse.Default

    ' 4. Conclusione con il messaggio finale pulito
    If Not Error Then
      txtLogPerformance.Text &= "\n[OK] Ottimizzazione completata con successo!"
      Message.Info("Le prestazioni del sistema DebLinux sono ora ottimizzate!", "Ottimo")
    Else
      txtLogPerformance.Text &= "\n[ERRORE] L'ottimizzazione ha riscontrato un problema."
      Message.Error("Impossibile completare l'ottimizzazione del sistema.")
    Endif
    
  Else
    txtLogPerformance.Text = "Ottimizzazione annullata dall'utente."
  Endif
End

