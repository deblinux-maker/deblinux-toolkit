Public Sub btnAnnulla_Click()
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sComando As String

  If $hProc Then
    $bAnnullato = True 
    
    ' 1. Controlliamo se abbiamo la password salvata per i comandi amministrativi
    If Exist(sConfFile) Then
      Try sPassword = FromBase64$(File.Load(sConfFile))
    Endif

    ' 2. Prima fermiamo rsync per bloccare subito la scrittura su disco
    sComando = "killall rsync"
    If sPassword <> "" Then
      Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- " & sComando) Wait
    Else
      Shell "pkexec " & sComando Wait
    Endif

    ' 3. Poi terminiamo il processo principale di Gambas che gestiva la shell
    Try $hProc.Kill()
    
    txtLog.Insert("\n--- Operazione annullata dall'utente. Pulizia completata. ---\n")
    btnCreaSnapshot.Enabled = True
    btnGestisciSnapshot.Enabled = True
    btnAnnulla.Enabled = False
    $hProc = Null
  Endif
End
Public Sub AggiornaStatisticheRAM()
  Dim sLine As String
  Dim aParts As String[]
  Dim lTotal As Long = 0
  Dim lFree As Long = 0
  Dim lBuffers As Long = 0
  Dim lCached As Long = 0
  Dim fPercent As Float
  
  If Exist("/proc/meminfo") Then
    For Each sLine In Split(File.Load("/proc/meminfo"), "\n")
      ' Dividiamo la riga per spazi (rimuovendo elementi vuoti)
      aParts = Split(sLine, " ", "", True)
      If aParts.Count >= 2 Then
        If aParts[0] = "MemTotal:" Then lTotal = Val(aParts[1])
        If aParts[0] = "MemFree:" Then lFree = Val(aParts[1])
        If aParts[0] = "Buffers:" Then lBuffers = Val(aParts[1])
        If aParts[0] = "Cached:" Then lCached = Val(aParts[1])
      End If
    Next
    
    If lTotal > 0 Then
      Dim lUsed As Long = lTotal - (lFree + lBuffers + lCached)
      fPercent = lUsed / lTotal
      
      PercentRAM = fPercent
      DrawingArea4.Refresh()
    End If
  End If
  
End Sub

Public Sub AggiornaStatisticheCPU()
  Dim sLine As String
  Dim aParts As String[]
  Static lPrevIdle As Long = 0
  Static lPrevTotal As Long = 0
  Dim lUser As Long, lNice As Long, lSystem As Long, lIdle As Long
  Dim lTotal As Long, lTotalDiff As Long, lIdleDiff As Long
  
  If Exist("/proc/stat") Then
    sLine = File.Load("/proc/stat")
    For Each sLine In Split(sLine, "\n")
      If sLine Begins "cpu " Then
        aParts = Split(sLine, " ", "", True)
        If aParts.Count >= 5 Then
          lUser = Val(aParts[1])
          lNice = Val(aParts[2])
          lSystem = Val(aParts[3])
          lIdle = Val(aParts[4])
          
          lTotal = lUser + lNice + lSystem + lIdle
          lTotalDiff = lTotal - lPrevTotal
          lIdleDiff = lIdle - lPrevIdle
          
          If lTotalDiff > 0 Then
            PercentCPU = (lTotalDiff - lIdleDiff) / lTotalDiff
          End If
          
          lPrevTotal = lTotal
          lPrevIdle = lIdle
          Break
        End If
      End If
    Next
    
    DrawingArea2.Refresh()
  End If
  
End Sub


Public Sub DrawingArea2_Draw()
  Dim Percent As Float = PercentCPU 
  Dim X As Float = DrawingArea2.W / 2
  Dim Y As Float = DrawingArea2.H / 2
  Dim Radius As Float = Min(X, Y) - 10
  
  ' 1. Imposta lo spessore del tratto per il bordo
  Draw.LineWidth = 6 
  
  ' 2. Sfondo del cerchio esterno (anello grigio scuro)
  Draw.Foreground = Color.DarkGray
  Draw.Circle(X, Y, Radius)
  
  ' 3. Cerchio colorato della CPU (verde brillante)
  Draw.Foreground = Color.RGB(46, 204, 113)
  Draw.Circle(X, Y, Radius)
  
  ' Ripristina lo spessore normale per il testo
  Draw.LineWidth = 1
  
  ' 4. Testo percentuale dinamico al centro
  Dim TextVal As String = CStr(CInt(Percent * 100)) & "%"
  Draw.Font.Size = 12
  Draw.Font.Bold = True
  Draw.Foreground = Color.White
  Draw.Text(TextVal, X - (Draw.TextWidth(TextVal) / 2), Y - (Draw.TextHeight(TextVal) / 2) - 4)
  
