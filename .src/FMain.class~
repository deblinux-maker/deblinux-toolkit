Public Sub ControllaAggiornamentiSito()
  Dim sVersioneRemota As String
  Dim sVersioneLocale As String = "0.0.56"
  Dim sFileTemp As String = Temp() ' Usa Temp() per un percorso sicuro

  ' 1. Scarichiamo il file - CORRETTO LO SPAZIO E LE VIRGOLETTE
  ' Ho aggiunto -f per generare errore se il sito non risponde
  Shell "curl -sfL -A 'Deblinuxtoolkit' https://andrealinux.it/software/software/Deblinux-toolkit/deblinuxtoolkit.txt > " & sFileTemp Wait

  ' 2. Verifichiamo se il file esiste e ha contenuto
  If Exist(sFileTemp) Then
    sVersioneRemota = Trim(File.Load(sFileTemp))
    
    ' Debug in console
    'Print "[DEBUG] Locale: " & sVersioneLocale
    'Print "[DEBUG] Remota: " & sVersioneRemota
    
    ' 3. CONTROLLO SICUREZZA
    ' Se il file è vuoto o contiene troppo testo (HTML), fermiamoci
    If Len(sVersioneRemota) = 0 Or If Len(sVersioneRemota) > 10 Then
       'Print "Errore: Dati ricevuti non validi o sito non raggiungibile."
       Return
    Endif

    ' 4. Confronto versioni
    ' Usiamo Val() se sono numeri o Trim() per sicurezza
Dim iVersioneLocaleNum As Integer = Val(Replace(sVersioneLocale, ".", ""))
    Dim iVersioneRemotaNum As Integer = Val(Replace(sVersioneRemota, ".", ""))

    If iVersioneRemotaNum > iVersioneLocaleNum Then
        If Message.Question("È disponibile la versione " & sVersioneRemota & ".\nLa tua versione: " & sVersioneLocale & "\n\nVuoi scaricare l'aggiornamento?", "Sì, aggiorna", "No, grazie") = 1 Then
            ' Chiamata alla tua funzione di installazione
            ScaricaEdInstalla("deblinux-toolkit_" & sVersioneRemota & "_all.deb")
        Endif
    Else
        'Print "Nessun aggiornamento trovato. Il sistema è aggiornato."
    Endif
    
    ' Pulizia
    Try Kill sFileTemp
  Else
    Print "Errore: Impossibile scaricare il file della versione."
  Endif
End
Public Sub ScaricaEdInstalla(sNomeFile As String)
  Dim sUrl As String = "https://andrealinux.it/software/software/Deblinux-toolkit/" & sNomeFile
  Dim sDestinazione As String = "/tmp/" & sNomeFile
  Dim hProc As Process
  
  ' 1. Pulizia preventiva del file temporaneo
  If Exist(sDestinazione) Then Kill sDestinazione
  
  Print "--- Download in corso da: " & sUrl & " ---"
  
  ' 2. DOWNLOAD: Usiamo curl perché gestisce meglio i redirect e gli User-Agent
  ' -L: Segue i redirect
  ' -A: Simula un browser (evita errori 403 o 406)
  ' -f: Fail silently (non scarica pagine di errore HTML)
  hProc = Exec ["curl", "-L", "-A", "Mozilla/5.0", "-f", "-o", sDestinazione, sUrl]
  
  Do While hProc.State = Process.Running
    Wait 0.1
  Loop
  
  ' Controllo validità download
  If hProc.Value <> 0 Or Not Exist(sDestinazione) Then
    Message.Error("Download fallito! Codice errore: " & hProc.Value & "\nControlla la connessione o l'URL.")
    Return
  Endif
  
  Print "--- Installazione in corso... ---"
  
  ' 3. INSTALLAZIONE: pkexec gestisce la richiesta password di root
  hProc = Exec ["pkexec", "apt", "install", "-y", sDestinazione]
  
  Do While hProc.State = Process.Running
    Wait 0.1
  Loop
  
  ' 4. POST-INSTALLAZIONE
  If hProc.Value = 0 Then
    Message.Info("Aggiornamento completato con successo! Il programma si riavvierà.")
    
    ' Pulizia finale
    If Exist(sDestinazione) Then Kill sDestinazione
    
    ' Riavvio del programma
    ' Usiamo sh -c per eseguire correttamente il comando di riavvio
    ' Assicurati che Application.Path &/ Application.Name sia il path corretto
    Shell "sh -c 'sleep 1 && " & Application.Path &/ Application.Name & "'"
    Quit
  Else
    Message.Error("Installazione fallita (codice " & hProc.Value & "). Operazione annullata.")
    If Exist(sDestinazione) Then Kill sDestinazione
  Endif
End

