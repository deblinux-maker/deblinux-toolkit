Private Sub AggiornaTemperatura()
  Dim sTempPath As String = ""
  Dim sTempRaw As String
  Dim aPaths As String[] = [
    "/sys/class/thermal/thermal_zone0/temp",
    "/sys/class/thermal/thermal_zone1/temp",
    "/sys/class/hwmon/hwmon0/temp1_input",
    "/sys/class/hwmon/hwmon1/temp1_input",
    "/sys/class/hwmon/hwmon2/temp1_input"
  ]
  
  ' Trova il primo percorso valido disponibile sul sistema
  For Each sTempPath In aPaths
    If Exist(sTempPath) Then Break
    sTempPath = ""
  Next
  
  If sTempPath <> "" Then
    ' Legge il file di sistema trovato
    sTempRaw = Trim(File.Load(sTempPath))
    
    ' Converte in gradi Celsius
    Dim fTemp As Float = Val(sTempRaw) / 1000
    
    ' Mostra il valore nella Label
    lblTemperatura.Text = Format(fTemp, "0.0") & " °C"
    
    ' Aggiorna la ProgressBar (ipotizzando un range sicuro tra 20°C e 90°C)
    Dim fValue As Float = (fTemp - 20) / (90 - 20)
    If fValue < 0.0 Then fValue = 0.0
    If fValue > 1.0 Then fValue = 1.0
    ProgressBarTemp.Value = fValue
    
    ' Gestione allarme visivo se supera i 75°C
    If fTemp >= 75.0 Then
      lblTemperatura.Foreground = Color.Red
    Else
      lblTemperatura.Foreground = Color.Default
    End If
  Else
    lblTemperatura.Text = "N/D"
    ProgressBarTemp.Value = 0
  End If

End Sub

Public Sub TimerTermico_Timer()

  AggiornaTemperatura()

End
Public Sub btnRaffredda_Click()
  Dim sPassword As String
  Dim sCheck As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  
  ' 1. Chiede conferma all'utente prima di procedere
  If Message.Question("Vuoi attivare la modalità di raffreddamento?", "Sì", "No") <> 1 Then 
    Return ' Se l'utente clicca su "No", esce e non fa nulla
  End If
  
  ' 2. Verifica se il pacchetto linux-cpupower è installato
  Shell "which cpupower" To sCheck
  If Trim(sCheck) = "" Then
    Message.Warning("Il pacchetto 'linux-cpupower' non è installato sul sistema.\n\nInstallalo da terminale con:\nsudo apt install linux-cpupower", "Capito")
    Return
  End If
  
  ' 3. Recupera la password decodificandola dal file di configurazione corretto
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  End If
  
  If Trim(sPassword) = "" Then
    Message.Warning("Nessuna password di amministrazione salvata nelle impostazioni.\nConfigurala prima nella sezione apposita del toolkit.", "OK")
    Return
  End If
  
  ' 4. Esegue il comando passando la password salvata in automatico
  Try Shell "echo " & Shell(sPassword) & " | sudo -S cpupower frequency-set -g powersave" Wait
  
  If Error Then
    Message.Error("Impossibile applicare il comando. Controlla che la password salvata sia corretta.", "OK")
  Else
    Message.Info("Modalità di raffreddamento attivata con successo (Governor: powersave).", "OK")
  End If
End Sub

