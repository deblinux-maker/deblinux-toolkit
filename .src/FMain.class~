' Funzione per identificare se è un SSD o un HDD
Public Function IsSSD(sDev As String) As Boolean
  Dim sCleanDev As String = Replace(sDev, "/dev/", "")
  Dim sRotaPath As String = "/sys/block/" & sCleanDev & "/queue/rotational"
  Dim sModelPath As String = "/sys/block/" & sCleanDev & "/device/model"
  Dim sNomeModello As String
  
  ' 1. Metodo primario e più affidabile del kernel (0 = SSD, 1 = HDD)
  If Exist(sRotaPath) Then
    If Trim(File.Load(sRotaPath)) = "0" Then Return True
    If Trim(File.Load(sRotaPath)) = "1" Then Return False
  Endif
  
  ' 2. Metodo secondario basato sul nome del modello (se il primo non è disponibile)
  If Exist(sModelPath) Then
    sNomeModello = Upper(Trim(File.Load(sModelPath)))
    
    If InStr(sNomeModello, "SANDISK") Then Return True
    If InStr(sNomeModello, "SSD") Then Return True
    If InStr(sNomeModello, "NVME") Then Return True
  Endif
  
  ' 3. Valore di fallback predefinito se nessun controllo Sysfs risponde
  Return True  
End
' Funzione principale di analisi
Public Function GetInfoDiscoCompleto(sDev As String) As String[]
  Dim sOut As String
  Dim aRisultati As New String[]
  Dim sOre As String = "Non disponibile"
  Dim sScritture As String = "Non disponibile"
  Dim aParole As String[] ' <--- DICHIARALA QUI UNA VOLTA SOLA

  Shell "pkexec /usr/sbin/smartctl -A /dev/" & sDev To sOut
  
  ' CONTROLLO: Se sOut è vuoto, l'utente ha annullato o c'è stato un errore
  If Trim(sOut) = "" Then 
     Return Null ' Restituiamo un valore nullo per indicare il fallimento
  Endif
  
  For Each sRiga As String In Split(sOut, "\n")
    sRiga = Trim(sRiga)
    
    ' 1. Cerca Ore (ID 9)
    If InStr(sRiga, "9 Power_On_Hours") Then
       aParole = Split(sRiga, " ", "", True) ' Senza "Dim" davanti
       sOre = aParole[aParole.Max]
    Endif
    
    ' 2. Cerca Scritture (ID 241)
    If Left(sRiga, 3) = "241" Then
       aParole = Split(sRiga, " ", "", True) ' Senza "Dim" davanti
       sScritture = aParole[aParole.Max] & " GiB"
    Endif
  Next
  
  aRisultati.Add(sOre)
  aRisultati.Add(sScritture)
  
  ' ... resto del codice ...  
  ' TRIM
  Shell "systemctl status fstrim.timer | grep 'Active:'" To sOut
  If InStr(sOut, "active") Then aRisultati.Add("Attiva") Else aRisultati.Add("Non attiva")
  
  Return aRisultati
End
Public Sub CaricaDischi()
  Dim sOut As String
  Dim sRiga As String
  Dim sModello As String
  Dim sTipo As String
  cmbDischi.Add("--- Seleziona un disco ---")
  cmbElencoDischi.Add("--- Seleziona un disco ---")
  Shell "lsblk -d -n -o NAME" To sOut
  
  For Each sRiga In Split(sOut, "\n", "", True)
    sRiga = Trim(sRiga)
    
    ' 1. Esclusioni immediate
    If InStr(sRiga, "zram") Then Continue
    If InStr(sRiga, "sr") Then Continue  ' 'sr' è il prefisso standard per i lettori CD/DVD in Linux
    
    ' 2. Verifica che sia un disco con un modello
    If Exist("/sys/block/" & sRiga & "/device/model") Then
      
      ' 3. Controllo tipo (Tipo 5 = lettore ottico)
      If Exist("/sys/block/" & sRiga & "/device/type") Then
        Shell "cat /sys/block/" & sRiga & "/device/type" To sTipo
        If Trim(sTipo) = "5" Then Continue 
      Endif
      
      ' Caricamento dati
      Shell "cat /sys/block/" & sRiga & "/device/model" To sModello
      sModello = Trim(sModello)
      
      If sModello <> "" Then
        cmbDischi.Add("/dev/" & sRiga & " (" & sModello & ")")
        cmbElencoDischi.Add("/dev/" & sRiga & " (" & sModello & ")")
      Endif
    Endif
  Next
End

