Public Sub btnPulisci_Click()
  $iInEsecuzione = 1
  Dim aComandiRoot As New String[]
  Dim aComandiUser As New String[]
  Dim sComandoRootUnito As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Comandi di sistema (richiedono root)
  If chkCache.Value Then aComandiRoot.Add("apt-get clean")
  If chkOrfani.Value Then aComandiRoot.Add("apt-get autoremove -y")
  If chkLogs.Value Then 
    aComandiRoot.Add("journalctl --vacuum-time=1s") 
  Endif
  If chkTmp.Value Then  
    aComandiRoot.Add("rm -rf /tmp/pkg 2>/dev/null || true; find /tmp -mindepth 1 -maxdepth 1 ! -name 'gambas.*' ! -name '.*-unix' ! -name 'systemd-private-*' -exec rm -rf {} + 2>/dev/null || true")
  Endif
  
  ' Gestione Flatpak / Snap
  If chkFlatpakSnap.Value Then
    aComandiRoot.Add("if command -v flatpak >/dev/null 2>&1; then flatpak uninstall --unused -y; fi")
    aComandiRoot.Add("if command -v snap >/dev/null 2>&1; then snap set system refresh.retain=2; snap list --all | awk '/disabled/{print $1, $2}' | while read snapname revision; do snap remove '$snapname' --revision='$revision'; done; fi")
  Endif
  
  ' Svuotamento Cestino come ROOT (così elimina anche i file con i lucchetti)
  If chkTrash.Value Then  
    aComandiRoot.Add("rm -rf " & Shell(User.Home) & "/.local/share/Trash/* 2>/dev/null || true")
  Endif

  ' Marcatore di fine operazioni per i comandi di root
  If aComandiRoot.Count > 0 Then aComandiRoot.Add("echo 'FINE_OPERAZIONI'")
  
  ' 2. Comandi utente (senza root)
  If chkAppLogs.Value Then
    aComandiUser.Add("find ~/.cache -name '*.log' -delete 2>/dev/null || true")
  Endif

  If chkThumbnails.Value Then
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/mozilla/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/google-chrome/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/BraveSoftware/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/chromium/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/opera/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/microsoft-edge/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/vivaldi/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/midori/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/qutebrowser/* 2>/dev/null || true")
    aComandiUser.Add("rm -rf " & User.Home & "/.cache/thumbnails/* 2>/dev/null || true")
    aComandiUser.Add("find ~/.cache -name '*.log' -delete 2>/dev/null || true")
  Endif

  ' Controllo se nulla è selezionato
  If aComandiRoot.Count = 0 And aComandiUser.Count = 0 Then
    Message.Warning("Seleziona almeno un'opzione!")
    Return
  Endif

  ' Verifichiamo subito se abbiamo la password salvata (se ci sono comandi di sistema)
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  ' Se l'utente ha selezionato opzioni di sistema ma NON ha salvato la password, blocchiamo preventivamente
  If aComandiRoot.Count > 0 And sPassword = "" Then
    Message.Warning("Le opzioni di pulizia di sistema richiedono i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, questa funzione richiede che la password di root sia salvata nelle impostazioni generali del programma.")
    Return
  Endif

  ' Inizializzazione contatori e barra
  fTotaleOperazioni = aComandiRoot.Count + aComandiUser.Count
  fProgressoCorrente = 0
  ProgressBar1.Value = 0

  ' 3. CONFERMA DI SICUREZZA
  If Message.Question("Procedere con la pulizia? Questa operazione è definitiva.", "Annulla", "Conferma") <> 2 Then Return

  ' 4. ESECUZIONE
  btnPulisci.Enabled = False
  txtLog.Clear
  txtLog.Text &= ("[CLEANER] Avvio pulizia sicura...\n")

  ' Eseguiamo prima la parte utente (senza root)
  If aComandiUser.Count > 0 Then
    txtLog.Insert("[LOG] Avvio pulizia file utente...\n")
    Shell aComandiUser.Join(" && ") Wait
    txtLog.Insert("[OK] Pulizia file utente completata.\n")
    ProgressBar1.Value = 0.4
  Endif

  ' Eseguiamo la parte di sistema sfruttando la password salvata
  If aComandiRoot.Count > 0 Then
    sComandoRootUnito = aComandiRoot.Join(" && ")
    
    txtLog.Insert("[LOG] Avvio pulizia di sistema...\n")
    
    Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sComandoRootUnito)] For Read As "ProcPulizia"
    
  Else
    ProgressBar1.Value = 1.0
    txtLog.Insert("[OK] Pulizia terminata con successo!\n")
    Message.Info("Pulizia terminata con successo!")
    btnPulisci.Enabled = True
  Endif
  
  If Error Then
    Message.Error("Impossibile avviare la pulizia: " & Error.Text)
