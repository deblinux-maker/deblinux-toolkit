Public Sub CaricaConfigGrub()
  Dim sPercorso As String = "/etc/default/grub"
  
  ' Controlliamo se il file esiste prima di caricarlo
  If Exist(sPercorso) Then
    Try txtGrub.Text = File.Load(sPercorso)
    If Error Then
      Message.Error("Errore durante la lettura del file di configurazione GRUB.")
    Endif
  Else
    ' Se per qualche motivo non lo trova, creiamo un testo di fallback o avvisiamo
    Message.Warning("Il file /etc/default/grub non è stato trovato.")
    txtGrub.Text = "# File non trovato o permessi insufficienti."
  Endif
End

