  ' pkexec leggerà la policy org.deblinux.toolkit.policy
  ' Se trova allow_active=yes, eseguirà il comando istantaneamente
  Shell "journalctl -n 50 --no-pager" To sLog
  
  If Len(Trim(sLog)) = 0 Then
     ' Piano B: se pkexec fallisce, proviamo il metodo standard
     Shell "journalctl -n 50 --no-pager" To sLog
