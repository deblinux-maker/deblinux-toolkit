  If Not Exist(sPathOrigine) Then
    Message.Error("Il file sorgente non esiste: " & sPathOrigine)
    Return
  Endif
  
  If Not Exist(sDestinazione) Then Mkdir sDestinazione
  
  Try Move sPathOrigine To sDestinazione & sNomeFile
  
  If Error Then
    Message.Error("Errore durante il ripristino: " & Error.Text)
  Else
    CaricaStartup()
  Endif
End
Public Sub CaricaInfoSistema()
  ' 1. --- INFO GENERALI ---
  ' Usiamo una variabile per accumulare il testo, è più ordinato
  Dim sInfo As String
  sInfo = "Nome Host: " & EseguiComando("hostname") & "\n" &
          "Kernel: " & EseguiComando("uname -r") & "\n" &
          "Distribuzione: " & File.Load("/etc/debian_version") & "\n" &
          "Architettura: " & EseguiComando("uname -m") & "\n" &
          "Uptime: " & EseguiComando("uptime -p | sed 's/up //'") & "\n" &
          "Scheda Madre: " & EseguiComando("cat /sys/devices/virtual/dmi/id/board_name")
  TextArea12.Text = sInfo

  ' 2. --- PANNELLO HARDWARE ---
  TextArea13.Text = "Scheda Madre: " & EseguiComando("cat /sys/devices/virtual/dmi/id/board_name") & "\n" &
                    "GPU: " & EseguiComando("lspci | grep -Ei 'vga|3d' | cut -d ':' -f3 | head -n 1") & "\n" &
                    "BIOS: " & EseguiComando("cat /sys/devices/virtual/dmi/id/bios_version")

  ' 3. --- PANNELLO RISORSE ---
  Dim sMemTotal As String = EseguiComando("grep MemTotal /proc/meminfo | awk '{print $2}'")
  Dim sMemFree As String = EseguiComando("grep MemFree /proc/meminfo | awk '{print $2}'")
  Dim fRamTotal As Float = Val(sMemTotal)
  Dim fRamFree As Float = Val(sMemFree)
  Dim fRamPerc As Float = (fRamTotal - fRamFree) / fRamTotal
  
  pbRam.Value = fRamPerc
  pbRam.Foreground = IIf(fRamPerc > 0.85, Color.Red, Color.Blue)
  
  Dim sDiscoPerc As String = EseguiComando("df -h / | tail -1 | awk '{print $5}' | sed 's/%//'")
  pbDisco.Value = Val(sDiscoPerc) / 100
  
  ' Temperatura CPU
  Dim sSensors As String = EseguiComando("cat /sys/class/hwmon/hwmon*/temp*_input /sys/class/thermal/thermal_zone*/temp 2>/dev/null | grep -v '^0$' | sort -rn | head -n 1")
  Dim sTempDisp As String
  
  If sSensors <> "" And If Val(sSensors) > 0 Then
     sTempDisp = Round(Val(sSensors) / IIf(Val(sSensors) > 1000, 1000, 1), 1) & " °C"
  Else
     sSensors = EseguiComando("sensors 2>/dev/null | grep -E -i 'Core|Tctl|edge|temp1' | sort -rn | head -n 1 | awk '{print $2}' | tr -d '+°C'")
     sTempDisp = IIf(sSensors <> "", Round(Val(sSensors), 1) & " °C", "N/D")
  Endif

  TextArea14.Text = "RAM Libera: " & Round(fRamFree / 1024, 1) & " MB\n" &
                    "Disco usato: " & sDiscoPerc & "%\n" &
                    "Temp. CPU: " & sTempDisp & "\n" &
                    "Stato ZRAM: " & IIf(Exist("/sys/block/zram0"), "Attiva", "Disattivata")

  ' 4. --- PANNELLO NETWORK ---
  Dim sIface As String = EseguiComando("ip route get 8.8.8.8 | awk '{print $5}' | head -n 1")
  Dim sIp As String = EseguiComando("ip addr show " & sIface & " | grep 'inet ' | awk '{print $2}' | cut -d/ -f1")
  
  txtNetwork.Text = "Interfaccia: " & IIf(sIface = "", "N/A", sIface) & "\n" &
                    "Indirizzo IP: " & IIf(sIp = "", "Non assegnato", sIp) & "\n" &
                    "Stato: " & IIf(sIp = "", "Disconnesso", "Online")
End
Public Function EseguiComando(sCmd As String) As String
  Dim sResult As String
  Shell sCmd To sResult
  Return Trim(sResult)
End
