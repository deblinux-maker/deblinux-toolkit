Public Sub btnSalvaKernel_Click()
  Dim sGovScelto As String = cmbCpuGov.Text
  Dim iSwapScelta As Integer = SliderSwap.Value
  Dim sComando As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' --- BLOCCO DI SICUREZZA PER PRINCIPIANTI ---
  If iSwapScelta = 0 Then
    If Message.Warning("Attenzione: Hai impostato la Swap a 0.\nI principianti potrebbero riscontrare blocchi se la RAM si esaurisce.\nVuoi davvero applicare questa impostazione?", "Procedi comunque", "Annulla") = 2 Then
      Return ' Interrompe tutto e non applica niente
    End If
  End If
  
  If iSwapScelta = 100 Then
    If Message.Question("Nota: La Swap a 100 è molto aggressiva sull'uso del disco.\nVuoi confermare?", "Sì, procedi", "Annulla") = 2 Then
      Return
    End If
  End If
  ' -------------------------------------------

  ' 2. Creiamo il comando interno da eseguire come root
  sComando = "for d in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do [ -f \"$d\" ] && echo " & sGovScelto & " > \"$d\"; done; sysctl vm.swappiness=" & iSwapScelta
  
  ' 3. Esecuzione sfruttando la password salvata (tramite sudo -S)
  Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sComando)) Wait
  
  Message.Info("Impostazioni applicate con successo!", "OK")
End Sub

