Public Sub CaricaRepository()
  Dim sFile As String
  
  ' Svuotiamo la lista prima di ricaricarla
  lstRepo.Clear
  
  ' 1. Aggiungiamo il file principale
  lstRepo.Add("/etc/apt/sources.list")
  
  ' 2. Aggiungiamo tutti i file extra nella cartella sources.list.d
  ' La funzione Dir ritorna solo i nomi dei file, quindi aggiungiamo il percorso
  For Each sFile In Dir("/etc/apt/sources.list.d/", "*.list")
    lstRepo.Add("/etc/apt/sources.list.d/" & sFile)
  Next
  
  ' Selezioniamo il primo elemento automaticamente per comodità
  If lstRepo.Count > 0 Then 
    lstRepo.Index = 0
    ' Richiamiamo il click per mostrare subito il contenuto
    lstRepo_Click()
  Endif
End
