    TxtLog.Text &= "\nErrore durante la disinstallazione Flatpak (Codice: " & Last.Value & ").\n"
    Message.Error("Si è verificato un errore durante la rimozione.")
  Endif

  CaricaPacchettiFlatpak()
End

