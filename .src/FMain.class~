Public Sub btnInstallaDriver_Click()
$iInEsecuzione = 1
  Dim sComando As String = ""
  Dim sHardwareRilevato As String
  Dim sPacchettiTrovati As String = ""
  Dim sAnalisiHardware As String
  Dim aPacchettiDaControllare As String[]
  Dim sPkg As String
  Dim sResPkg As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Disattiviamo subito il pulsante per evitare clic multipli
  btnInstallaDriver.Enabled = False
  
  ' 2. Verifichiamo subito se abbiamo la password salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("L'installazione dei driver e firmware richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, questa funzione richiede che la password di root sia salvata nelle impostazioni generali del programma.")
    btnInstallaDriver.Enabled = True
    Return
  Endif

  ' 3. Scansione hardware completa (PCI e USB)
  Shell "lspci; lsusb" To sAnalisiHardware
  txtLog.Text = "=== ANALISI HARDWARE GLOBALE IN CORSO ===\n" & sAnalisiHardware & "\n\n"

  ' 4. Rileviamo componenti critici dettagliati
  Shell "lspci -nn | grep -E 'VGA|Display|Network|Wireless|Audio|Bluetooth|Controller'" To sHardwareRilevato
  txtLog.Text &= "--- Componenti Principali Rilevati ---\n" & sHardwareRilevato & "\n\n"

  ' Definiamo la lista base dei pacchetti da controllare
  aPacchettiDaControllare = ["firmware-linux", "firmware-linux-free", "firmware-misc-non-free", "intel-microcode", "amd64-microcode", "firmware-iwlwifi", "firmware-realtek", "firmware-atheros", "firmware-ralink", "firmware-brcm80211", "cups", "cups-filters", "printer-driver-all", "sane-utils", "simple-scan"]

  ' Aggiungiamo dinamicamente in base all'hardware
  If InStr(Lower(sAnalisiHardware), "bluetooth") > 0 Or InStr(Lower(sHardwareRilevato), "bluetooth") > 0 Then
    aPacchettiDaControllare.Add("bluetooth")
    aPacchettiDaControllare.Add("bluez")
    aPacchettiDaControllare.Add("bluez-firmware")
  Else
    aPacchettiDaControllare.Add("bluetooth")
    aPacchettiDaControllare.Add("bluez")
  Endif

  ' NVIDIA
  If InStr(Lower(sHardwareRilevato), "nvidia") > 0 Then
    If InStr(Lower(sHardwareRilevato), "geforce 210") = 0 And InStr(Lower(sHardwareRilevato), "gt 218") = 0 Then
      aPacchettiDaControllare.Add("nvidia-driver")
    Endif
  Endif

  ' AMD / Radeon
  If InStr(Lower(sHardwareRilevato), "amd") > 0 Or InStr(Lower(sHardwareRilevato), "radeon") > 0 Then
    aPacchettiDaControllare.Add("firmware-amd-graphics")
    aPacchettiDaControllare.Add("libgl1-mesa-dri")
  Endif

  ' TLP (Batteria)
  If InStr(Lower(sAnalisiHardware), "battery") > 0 Or InStr(Lower(sHardwareRilevato), "battery") > 0 Then
    aPacchettiDaControllare.Add("tlp")
    aPacchettiDaControllare.Add("tlp-rdw")
  Endif

  ' 5. FILTRIAMO SOLO QUELLI NON INSTALLATI
  sComando = ""
  For Each sPkg In aPacchettiDaControllare
    ' Controlla se il pacchetto è installato tramite dpkg-query
    Shell "dpkg-query -W -f='${Status}' " & sPkg & " 2>/dev/null | grep -c 'install ok installed'" To sResPkg
    If Trim(sResPkg) = "0" Then
      ' Il pacchetto NON è installato, quindi lo aggiungiamo alla coda
      sComando &= " " & sPkg
      sPacchettiTrovati &= "- " & sPkg & " [DA INSTALLARE]\n"
    Else
      sPacchettiTrovati &= "- " & sPkg & " [GIÀ INSTALLATO]\n"
    Endif
  Next

  ' Se sComando è vuoto, significa che è già tutto installato!
  If Trim(sComando) = "" Then
    Message.Info("Tutti i driver e i firmware raccomandati sono già installati nel sistema!", "OK")
    btnInstallaDriver.Enabled = True
    Return
  Endif

' 6. Chiediamo conferma all'utente con l'elenco dei pacchetti mancanti
  If Message.Question("Il Driver Manager ha analizzato il tuo sistema.\n\nStato dei componenti:\n\n" & sPacchettiTrovati & "\nVuoi procedere all'installazione dei componenti mancanti?", "Annulla", "Procedi") <> 2 Then
    txtLog.Text &= "\nOperazione annullata dall'utente.\n"
    btnInstallaDriver.Enabled = True
    Return
  Endif

  txtLog.Text &= "\n=== AVVIO INSTALLAZIONE COMPONENTI MANCANTI ===\n"

  ' 7. Eseguiamo il comando sfruttando la password salvata (coerente con btnPulisci_Click)
  Dim sInstallCmd As String = "apt-get update && apt-get install -y " & sComando
  
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sInstallCmd)] For Read Write As "MyProcess"

  If Error Then
    Message.Error("Impossibile avviare l'installazione: " & Error.Text)
    btnInstallaDriver.Enabled = True
    Return
  Endif

  txtLog.Text &= "Installazione avviata in background...\n"
$iInEsecuzione = 0
End
