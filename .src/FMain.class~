Public Sub btnRiparaProfonda_Click()
  Dim hProc As Process
  Dim sCmd As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  panel2.Enabled = False
  
  ' 2. Conferma utente
  If Message.Question(("ATTENZIONE: Procedere con la riparazione profonda?"), ("Sì"), ("Annulla")) = 2 Then 
     panel2.Enabled = True
     Return
  Endif

  btnRiparaProfonda.Enabled = False
  txtLog.Clear
  txtLog.Insert(("=== AVVIO RIPARAZIONE PROFONDA ===") & Chr(10))
  txtLog.Insert(("Seguendo protocollo di sicurezza standard...") & "\n\n")

  sCmd = "dpkg --configure -a && apt-get install -f -y"

  ' 3. Avvio del processo sfruttando la password salvata (tramite sudo -S)
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sCmd & " 2>&1")] For Read As "ProcProfonda"
  
  If Error Or If Not hProc Then
    Message.Error(("Errore critico nell'avvio della riparazione: ") & Error.Text)
    btnRiparaProfonda.Enabled = True
    panel2.Enabled = True ' <--- Ripristiniamo il pannello anche in caso di errore di avvio
    Return
  Endif

  ' 4. Ciclo di monitoraggio
  While hProc.State = Process.Running
   If Not Eof(hProc) Then
      Dim sBuffer As String
      Read #hProc, sBuffer, -2048
      txtLog.Insert(sBuffer)
      txtLog.EnsureVisible
   Endif
   Wait 0.05
  Wend

  ' 5. CONTROLLO DEL SUCCESSO
  If hProc.Value = 0 Then
     txtLog.Insert("\n" & ("=== RIPARAZIONE COMPLETATA ===") & "\n")
     Message.Info(("Riparazione terminata con successo!"))
  Else
     txtLog.Insert("\n" & ("[ERRORE] Riparazione profonda fallita o annullata.") & "\n")
     Message.Error(("L'operazione di riparazione non è stata completata."))
  Endif
  
  panel2.Enabled = True
  btnRiparaProfonda.Enabled = True
End

Public Sub btnSincronizza_Click()
  Dim hProc As Process
  Dim sCmd As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
     Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
     Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
     Return
  Endif
  
  panel2.Enabled = False
  
  ' Messaggio di conferma
  If Message.Question("Questa operazione pulirà la cache di apt e ricaricherà gli indici dai server. Procedere?", "Sì", "Annulla") = 2 Then 
     panel2.Enabled = True
     Return
  End If

  btnSincronizza.Enabled = False
  txtLog.Clear
  txtLog.Insert("[FIXER] Sincronizzazione repository in corso...\n")
  
  ' Comando con rimozione preventiva dei lock per evitare blocchi fantasma
  sCmd = "rm -f /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock && apt-get clean && rm -rf /var/lib/apt/lists/* && apt-get update"

  ' 2. Avviamo il processo sfruttando la password salvata (tramite sudo -S)
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sCmd & " 2>&1")] For Read As "ProcSincronizza"
  
  If Error Or If Not hProc Then
    Message.Error("Errore critico durante la sincronizzazione: " & Error.Text)
    btnSincronizza.Enabled = True
    panel2.Enabled = True 
    Return
  Endif

  ' Ciclo di monitoraggio fluido
  While hProc.State = Process.Running
    If Not Eof(hProc) Then
      Dim sBuffer As String
      Read #hProc, sBuffer, -2048
      txtLog.Insert(sBuffer)
      txtLog.EnsureVisible
    Endif
    Wait 0.05
  Wend

  ' Controllo del successo finale
  If hProc.Value = 0 Then
     txtLog.Insert("\n[FIXER] Sincronizzazione completata con successo.\n")
     Message.Info("Repository aggiornati correttamente.")
  Else
     txtLog.Insert("\n[FIXER] Attenzione: Sincronizzazione fallita o annullata.\n")
     Message.Error("L'operazione non è stata completata.")
  Endif
  
  btnSincronizza.Enabled = True
  panel2.Enabled = True
  ' Aggiorna lo stato del sistema per spegnere i pulsanti se tutto è a posto
  Me.BtnCheckStato_Click()
End

Public Sub btnCheckStato_Click()
  Dim bStatus As Boolean
  Dim sOut As String
  Dim bBroken As Boolean = False
  Dim bUpdate As Boolean = False
  Dim bLocked As Boolean = False
  
  bStatus = Status(lblStatoBlocco, txtLog)
  txtLog.Clear
  txtLog.Insert("--- AVVIO ANALISI SISTEMA ---\n")
  
  ' 1. Eseguiamo il controllo
  Shell "apt-get --simulate install -f 2>&1" To sOut
  
  ' 2. Analisi pacchetti
  If InStr(sOut, "is not installed") > 0 Or InStr(sOut, "broken") > 0 Then
     txtLog.Insert("[ERRORE] Rilevati pacchetti rotti!\n")
     bBroken = True
  Else
     txtLog.Insert("[OK] Nessun pacchetto rotto.\n")
  Endif
  
  ' 3. Controllo aggiornamenti
  If InStr(sOut, "0 aggiornati, 0 installati, 0 da rimuovere") = 0 Then
     txtLog.Insert("[INFO] Aggiornamenti disponibili.\n")
     bUpdate = True
  Endif
  
' 4. Controllo Database (con attesa intelligente)
  If CheckDatabaseLock() Then
     txtLog.Insert("[ERRORE] Database BLOCCATO (file lock presenti).\n")
     bLocked = True
  Else
     txtLog.Insert("[OK] Database libero.\n")
     bLocked = False
  Endif

  ' --- LOGICA DI ABILITAZIONE INTELLIGENTE ---
  
  ' A. RESET DEI SOLI STRUMENTI DI RIPARAZIONE (Spegniamo le azioni di scrittura)
  btnCorreggi.Enabled = False
  btnFixUpdate.Enabled = False
  btnFixBroken.Enabled = False
  btnAutoremove.Enabled = False
  btnFixKeys.Enabled = False
  btnRiparaProfonda.Enabled = False
  
  ' B. STRUMENTI DI LETTURA / SICURI: Rimangono SEMPRE attivi
  btnInfo.Enabled = True
  btnCheckIntegrita.Enabled = True
  
  ' C. ABILITAZIONE MIRATA DEI FIX IN BASE AI PROBLEMI TROVATI
  If bLocked Then 
     btnFixUpdate.Enabled = True
     btnCorreggi.Enabled = True
  Endif
  
  If bBroken Then 
     btnFixBroken.Enabled = True
     btnCorreggi.Enabled = True
  Endif
  
  If bUpdate Then 
     btnSincronizza.Enabled = True
  Endif
  
  txtLog.Insert("\n--- ANALISI TERMINATA ---\n")
  If (bBroken Or bLocked) Then
     txtLog.Insert("[INFO] Problemi rilevati! Gli strumenti di riparazione sono attivi.")
  Else
     txtLog.Insert("[INFO] Sistema in salute.")
  Endif
  
' --- ABILITAZIONE E EVIDENZIAZIONE VISIVA ---
  
  ' 1. Spegniamo tutti i pulsanti di correzione e resettiamo i colori
  Dim hBtn As Button
  For Each hBtn In [btnCorreggi, btnFixUpdate, btnFixBroken, btnAutoremove, btnFixKeys, btnRiparaProfonda, btnSincronizza]
     hBtn.Enabled = False
     hBtn.Foreground = Color.Default ' Colore normale/spento
  Next

  ' 2. Pulsanti di sola lettura sempre attivi e ben visibili
  btnInfo.Enabled = True
  btnCheckIntegrita.Enabled = True

  ' 3. Attiviamo ed evidenziamo in VERDE solo se ci sono problemi critici (Database bloccato o Pacchetti rotti)
  If bLocked Then 
     btnFixUpdate.Enabled = True
     btnFixUpdate.Foreground = Color.Green
     btnCorreggi.Enabled = True
     btnCorreggi.Foreground = Color.Green
  Endif
  
  If bBroken Then 
     btnFixBroken.Enabled = True
     btnFixBroken.Foreground = Color.Green
     btnCorreggi.Enabled = True
     btnCorreggi.Foreground = Color.Green
  Endif
  
  ' Nota: Il blocco "If bUpdate Then" è stato rimosso, 
  ' quindi il tasto Sincronizza non si accenderà più automaticamente per i semplici aggiornamenti.
End
Public Sub btnFixUpdate_Click()
  Dim sComando As String
  Dim sRisultato As String
  Dim sProcessoBloccante As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim i As Integer
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione di sblocco richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Identifichiamo chi sta bloccando il file prima di agire
  Try Shell "fuser /var/lib/dpkg/lock-frontend 2>/dev/null" To sProcessoBloccante
  sProcessoBloccante = Trim(sProcessoBloccante)
  
  If sProcessoBloccante <> "" Then
    txtLog.Insert("[INFO] Processo bloccante rilevato (PID: " & sProcessoBloccante & "). Tentativo di terminazione...\n")
  Endif

  ' Se il lock è orfano (nessun PID attivo), basta eliminare i file direttamente
  If sProcessoBloccante = "" Then
    txtLog.Insert("[INFO] Rilevato lock orfano. Pulizia in corso...\n")
    Main.EseguiConSudo("rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock")
    lblStatoBlocco.Text = "Database Libero (pulito)"
    lblStatoBlocco.Foreground = Color.Green
    Message.Info("Lock orfano rimosso con successo!")
    btnCheckStato_Click()
    Return
  Endif

  txtLog.Insert("\n[INFO] Tentativo di sblocco forzato in corso...")
  
  ' Esecuzione comando di sblocco tramite la funzione centralizzata
  sComando = "chattr -i /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend 2>/dev/null; " & 
             "fuser -k /var/lib/dpkg/lock-frontend 2>/dev/null; " & 
             "fuser -k /var/lib/dpkg/lock 2>/dev/null; " & 
             "rm -f /var/lib/apt/lists/lock /var/cache/apt/archives/lock /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend"
  
  sRisultato = Main.EseguiConSudo(sComando)
  
  ' 3. Attesa intelligente: verifichiamo più volte prima di arrenderci
  For i = 1 To 5
    If Not (Exist("/var/lib/dpkg/lock") Or Exist("/var/lib/dpkg/lock-frontend")) Then Break
    Wait 0.5 ' Aspetta 0.5 secondi ad ogni ciclo
  Next
  
  ' 4. Verifica finale
  If Exist("/var/lib/dpkg/lock") Or Exist("/var/lib/dpkg/lock-frontend") Then
     Message.Error("La riparazione non ha avuto successo. Un servizio di sistema (es. PackageKit o apt-daily) sta ricreando il blocco. Riprova tra qualche istante.")
     txtLog.Insert("\n[ERRORE] I file risultano ancora bloccati.")
  Else
     Message.Info("Database sbloccato con successo!")
     txtLog.Insert("\n[OK] Database pulito correttamente.")
     Wait 1.0
     btnCheckStato_Click() ' Aggiorna l'interfaccia
  Endif
End
