  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Individuiamo il percorso corretto di ufw
  If Exist("/usr/sbin/ufw") Then 
    sPath = "/usr/sbin/ufw"
  Else If Exist("/sbin/ufw") Then 
    sPath = "/sbin/ufw"
  Endif

  txtLog.Insert("\n🛡️ Tentativo di attivazione protezione...\n")
  txtLog.Pos = txtLog.Length
  
  ' Se il motore ufw non esiste proprio sul sistema
  If sPath = "" Then
    txtLog.Insert("📦 Motore non trovato, provo a installarlo...\n")
    
    ' Installazione sfruttando la password salvata (tramite sudo -S)
    Dim sInstallCmd As String = "apt-get install ufw -y"
    Try Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sInstallCmd)) Wait
    
