Public Sub EseguiAggiornamento()
  Dim sOut As String
  Dim aRighe As String[]
  Dim i As Integer
  Dim aDati As String[]
  Dim sComando As String

  Try Shell "ps -eo pid,pcpu,pmem,args --sort=-pcpu --no-headers | head -n 15" To sOut
  
  If Error Or If Not sOut Then Return
  
  aRighe = Split(Trim(sOut), "\n", "", True)
  
  gvProcessi.Columns.Count = 4
  ' Aggiungiamo +1 alle righe per riservare la prima ai nostri titoli personalizzati
  gvProcessi.Rows.Count = aRighe.Count + 1
  
  gvProcessi.Background = &H1B252F   
  gvProcessi.Foreground = Color.White   
  gvProcessi.Rows.Height = 26           
  
  ' SPEGNAMO L'INTESTATURA NATIVA PROBLEMATICA
  gvProcessi.Header = GridView.None 

  ' --- CREIAMO LA PRIMA RIGA COME INTESTAZIONE PERSONALIZZATA ---
  gvProcessi[0, 0].Text = "PID"
  gvProcessi[0, 1].Text = "%CPU"
  gvProcessi[0, 2].Text = "%MEM"
  gvProcessi[0, 3].Text = "Comando"
  
  ' Diamo un colore di sfondo e testo ben leggibile alla riga di intestazione (es. grigio scuro e testo giallo/bianco)
  For i = 0 To 3
    gvProcessi[0, i].Background = &H2C3E50
    gvProcessi[0, i].Foreground = Color.Yellow
  Next

  ' --- POPOLAMENTO DEI PROCESSIreali (partendo dalla riga 1) ---
  For i = 0 To aRighe.Max
    aDati = Split(Trim(aRighe[i]), " ", "", True, 3)
    
    If aDati.Count >= 4 Then
       sComando = aDati[3]
       
       ' Filtro di sicurezza processi critici
       If InStr(sComando, "Xorg") > 0 Or InStr(sComando, "mate-session") > 0 Or InStr(sComando, "lightdm") > 0 Then
         Continue 
       Endif
       
       If Val(aDati[0]) = Application.Id Then
         sComando = "Deblinux Toolkit"
       Else If InStr(sComando, "gbr3") > 0 Or InStr(sComando, "gbx3") > 0 Then
         sComando = "Interprete Gambas (" & sComando & ")"
       Endif
       
       ' Inseriamo i dati spostati di una riga in basso (+1)
       gvProcessi[i + 1, 0].Text = aDati[0] 
       gvProcessi[i + 1, 1].Text = aDati[1] & " %"  
       gvProcessi[i + 1, 2].Text = aDati[2] & " %"
       gvProcessi[i + 1, 3].Text = sComando
    Endif
  Next
  
  Label2.Text = "Monitor attivo - Ultimo agg: " & Format(Now, "hh:nn:ss")
End
Public Sub gvProcessi_Click()

  ' Se l'utente clicca sulla riga di intestazione (riga 0), usciamo subito senza fare nulla
  If gvProcessi.Row = 0 Then Return

  Dim sPid As String = gvProcessi[gvProcessi.Row, 0].Text
  Dim sNome As String = gvProcessi[gvProcessi.Row, 3].Text
  Dim iPidNum As Integer = Val(sPid)
  
  ' --- BLOCCHI DI SICUREZZA ---
  
  ' 1. Impedisci di terminare il Deblinux Toolkit
  If iPidNum = Application.Id Then
    Message.Warning("Impossibile terminare Deblinux Toolkit mentre è in esecuzione!", "OK")
    Return
  Endif
  
  ' 2. Impedisci di terminare i processi di sistema protetti (PID < 1000)
  If iPidNum < 1000 Then
    Message.Error("Operazione non consentita: questo è un processo protetto del sistema operativo!", "OK")
    Return
  Endif
  
  ' 3. Impedisci di terminare i processi critici del desktop e di sistema per nome
  If InStr(sNome, "Xorg") > 0 Or InStr(sNome, "mate-session") > 0 Or InStr(sNome, "mate-panel") > 0 Or InStr(sNome, "lightdm") > 0 Or InStr(sNome, "gdm") > 0 Or InStr(sNome, "sddm") > 0 Or InStr(sNome, "systemd") > 0 Or InStr(sNome, "pulseaudio") > 0 Or InStr(sNome, "pipewire") > 0 Then
    
    Message.Error("Operazione non consentita: questo è un servizio vitale del sistema!", "OK")
    Return
  Endif
  
  ' --- RICHIESTA DI CONFERMA ---
  If Message.Question("Vuoi terminare il processo " & sNome & " (PID: " & sPid & ")?", "Sì", "No") = 1 Then
    Shell "kill -9 " & sPid Wait
    EseguiAggiornamento() ' Ricarica subito
  Endif

End

