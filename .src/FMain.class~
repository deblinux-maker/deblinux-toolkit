Public Sub btnTestRete_Click()
  Dim sRes As String
  
  ' --- 1. TEST GATEWAY (Router locale) ---
  Shell "ping -c 1 -W 2 192.168.1.1 >/dev/null 2>&1 && echo 'OK' || echo 'FAIL'" To sRes
  If Trim(sRes) = "OK" Then
    lblGateway.Background = Color.DarkGreen
    lblGateway.Foreground = Color.White
    lblGateway.Text = "  Gateway: OK  "
  Else
    lblGateway.Background = Color.DarkRed
    lblGateway.Foreground = Color.White
    lblGateway.Text = "  Gateway: Errore  "
  End If
  
  ' --- 2. TEST DNS ---
  Shell "nslookup debian.org >/dev/null 2>&1 && echo 'OK' || echo 'FAIL'" To sRes
