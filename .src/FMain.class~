Public Sub ProcAggiorna_Read()
  Dim sLine As String
  While Not Eof(hProc)
    Line Input #hProc, sLine
    ' Aggiungi la riga solo se non è un avviso di apt o una riga vuota
    If InStr(sLine, "WARNING:") = 0 And Trim(sLine) <> "" Then
      txtLog.Text &= sLine & "\n"
    Endif
    
  Wend
  txtLog.Pos = Len(txtLog.Text)
End

