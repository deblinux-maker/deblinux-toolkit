Public Sub btnRipristinaServizi_Click()
  $iInEsecuzione = 1
  Dim sComando As String
  Dim sTipoAzione As String
  Dim sRisultato As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Verifichiamo lo stato della CheckBox
  If CheckBox1.Value Then
    ' Se la CheckBox è spuntata, l'azione è l'OTTIMIZZAZIONE
    If Message.Question("Vuoi procedere con l'ottimizzazione dell'avvio del sistema?", "Annulla", "Conferma") <> 2 Then Return
    sComando = "systemctl disable --now ModemManager.service && systemctl disable --now smartmontools.service && systemctl disable --now NetworkManager-wait-online.service"
    sTipoAzione = "ottimizzazione"
  Else
    ' Se la CheckBox NON è spuntata, l'azione è il RIPRISTINO
    If Message.Question("Vuoi ripristinare e riattivare i servizi di sistema?", "Annulla", "Conferma") <> 2 Then Return
    sComando = "systemctl enable --now ModemManager.service && systemctl enable --now smartmontools.service && systemctl enable --now NetworkManager-wait-online.service"
    sTipoAzione = "ripristino"
  Endif

  ' 3. Esecuzione dei comandi con la funzione centralizzata
  txtLog.Clear
  txtLog.Insert("[LOG] Avvio " & sTipoAzione & " in corso...\n")
  
  ' Chiamata tramite Main.EseguiConSudo
  sRisultato = Main.EseguiConSudo(sComando)
  
  ' Controlliamo se c'è stato un errore nell'output
  If InStr(Lower(sRisultato), "error") > 0 Or InStr(Lower(sRisultato), "failed") > 0 Then
    txtLog.Insert("[ERRORE] Impossibile completare l'operazione:\n" & sRisultato & "\n")
    Message.Error("Errore durante l'operazione.")
  Else
    txtLog.Insert("[OK] Operazione completata con successo!\n")
    Message.Info("Operazione completata con successo!")
    
    ' Aggiorniamo lo stato del pulsante/interfaccia
    CheckBox1_Click()
  Endif
$iInEsecuzione = 0
End
Public Sub AggiornaStatoServizi()
  Dim sOutput As String
  
