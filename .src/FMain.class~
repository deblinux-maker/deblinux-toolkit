Public Function CheckDatabaseLock() As Boolean
  Dim i As Integer
  For i = 1 To 5
    If Not Exist("/var/lib/dpkg/lock") And Not Exist("/var/lib/dpkg/lock-frontend") And Not Exist("/var/lib/apt/lists/lock") Then
       Return False 
    Endif
    Wait 0.5 
  Next
  Return True
End
Public Function CalcolaAppLogs() As String
  Dim sRisultato As String
  Dim sComando As String
  
  ' Costruiamo il comando concatenando le stringhe in modo sicuro
  sComando = "du -sm " & User.Home & "/.cache/mozilla " & 
             User.Home & "/.cache/google-chrome " & 
             User.Home & "/.cache/BraveSoftware " &
             User.Home & "/.cache/thumbnails " & 
             User.Home & "/.var/app/*/cache 2>/dev/null | awk '{sum+=$1} END {print sum}'"
  
  Shell sComando To sRisultato
  
  If Trim(sRisultato) = "" Then Return "0"
  
  Return Trim(sRisultato)
End

Public Sub CaricaStartup()
  Dim sFile As String
  Dim sPath As String
  Dim sLinea As String
  Dim sNomeApp As String
  Dim aFile As String[]
  Dim iRiga As Integer = 0
  
  gvStartup.Clear
  gvStartup.Rows.Count = 0
  gvStartup.Columns.Count = 2 ' Solo 2 colonne visibili, come Stacer!
  gvStartup.Columns[0].Text = ("Nome Applicazione")
  gvStartup.Columns[1].Text = ("Stato")
  gvStartup.Columns[0].Width = 350
  gvStartup.Columns[1].Width = 100
  
  ' Caricamento file ATTIVI
  sPath = User.Home &/ ".config/autostart/"
  If Exist(sPath) Then
    For Each sFile In Dir(sPath, "*.desktop")
      If Not IsDir(sPath &/ sFile) Then
        sNomeApp = File.BaseName(sFile)
        aFile = Split(File.Load(sPath &/ sFile), "\n")
        For Each sLinea In aFile
          If sLinea Begins "Name=" Then
            sNomeApp = Mid$(sLinea, 6)
            Break
          Endif
        Next
        
        gvStartup.Rows.Count += 1
        gvStartup[iRiga, 0].Text = sNomeApp
        gvStartup[iRiga, 1].Text = ("Attivo")
        gvStartup[iRiga, 0].Tag = sFile ' Salviamo il nome file nel Tag nascosto della riga
        iRiga += 1
      Endif
    Next
  Endif
  
  ' Caricamento file DISABILITATI
  sPath = User.Home &/ ".config/autostart/disabled/"
  If Exist(sPath) Then
    For Each sFile In Dir(sPath, "*.desktop")
      gvStartup.Rows.Count += 1
      gvStartup[iRiga, 0].Text = File.BaseName(sFile)
      gvStartup[iRiga, 1].Text = ("Disabilitato")
      gvStartup[iRiga, 0].Tag = sFile ' Salviamo il nome file nel Tag nascosto della riga
      iRiga += 1
    Next
  Endif
End
Public Function CalcolaCache() As String
  Dim sOutput As String
  Dim iCount As Integer
  
  ' Controlliamo prima se ci sono file .deb nella cartella usando Shell in modo sicuro
  Try Shell "find /var/cache/apt/archives -name '*.deb' 2>/dev/null | wc -l" To sOutput
  
  If Not Error Then
    iCount = Val(Trim(sOutput))
    If iCount = 0 Then Return "0" ' Se non ci sono deb, restituisce 0 MB puliti
  Endif
  
  ' Altrimenti calcoliamo lo spazio reale occupato
  Try Shell "du -sm /var/cache/apt/archives 2>/dev/null | awk '{print $1}'" To sOutput
  
  If Error Then Return "0"
  
  sOutput = Trim(Replace(Replace(sOutput, "\n", ""), "\r", ""))
  
  If sOutput = "" Then Return "0"
  Return sOutput
End
Public Function CalcolaCestino() As String
  Dim sOutput As String
  Dim sPath As String = User.Home &/ ".local/share/Trash/files"

  If Not Exist(sPath) Then Return "0"
  
  ' Controlliamo se la cartella è vuota contando i file al suo interno
  Shell "find " & Quote(sPath) & " -mindepth 1 | wc -l" To sOutput
  If Val(Trim(sOutput)) = 0 Then Return "0" ' Se è vuota, restituisce 0 MB
  
  ' Altrimenti calcola i MB reali
  Shell "du -sm " & Quote(sPath) & " 2>/dev/null | awk '{print $1}'" To sOutput
  sOutput = Trim(Replace(Replace(sOutput, "\n", ""), "\r", ""))
  
  If sOutput = "" Then Return "0"
  Return sOutput
End

' Funzione separata per pulire l'output: mantiene il codice pulito!
Private Function FiltraOutputApt(sInput As String) As String
  Dim sLine As String
  Dim sResult As String
  For Each sLine In Split(sInput, "\n")
    ' Cerchiamo solo le righe che contengono nomi di pacchetti o dati utili
    ' Ignoriamo le righe che iniziano con spazi o messaggi di errore comuni
    If Left(Trim(sLine), 1) <> "(" And Len(Trim(sLine)) > 0 Then
       ' Qui potresti aggiungere ulteriori filtri, es: If InStr(sLine, "will be removed")
       sResult &= sLine & "\n"
    Endif
  Next
  Return sResult
End
Public Sub btnFixBroken_Click()
  Dim hProc As Process
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  panel2.Enabled = False
  btnFixBroken.Enabled = False
  txtLog.Clear
  txtLog.Insert("=== RIPARAZIONE DIPENDENZE ROTTE ===\n")
  txtLog.Insert("Il sistema sta analizzando l'albero dei pacchetti...\n")
  
  ' 2. Avviamo il processo con la certezza che la password è presente (via sudo -S)
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- apt-get install -f -y"] For Read As "ProcFixBroken"
  
  ' Gestione errore critico
  If Error Or If Not hProc Then
    Message.Error("Errore nell'avvio della riparazione: " & Error.Text)
    btnFixBroken.Enabled = True
    panel2.Enabled = True
    Return
  Endif
  
  ' Ciclo di monitoraggio
  While hProc.State = Process.Running
    If Not Eof(hProc) Then
      Dim sBuffer As String
      Read #hProc, sBuffer, -2048
      txtLog.Insert(sBuffer)
      ' Forza lo scorrimento verso il basso
      txtLog.EnsureVisible 
    Endif
    Wait 0.05
  Wend
  
  ' CONTROLLO FINALE DEL RISULTATO
  If hProc.Value = 0 Then
     txtLog.Insert("\nAnalisi completata. Dipendenze riparate con successo.\n")
     btnFixBroken.Enabled = True
     Message.Info(("Procedura di riparazione terminata!"))
  Else
     ' Se Value != 0, l'utente ha annullato o il processo ha avuto un errore
     txtLog.Insert("\n[ERRORE] La riparazione è stata annullata o è fallita.\n")
     btnFixBroken.Enabled = True
     Message.Error(("Attenzione: Procedura di riparazione interrotta o fallita."))
  Endif
  panel2.Enabled = True
End
