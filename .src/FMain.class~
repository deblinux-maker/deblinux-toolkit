Public Sub btnChangelog_Click()
  Dim sKernelSelezionato As String
  Dim sOutput As String
  Dim sChangelogPath As String
  Dim sVersioneAttuale As String
  
  ' 1. Controlliamo se l'utente ha selezionato un kernel dalla lista
  sKernelSelezionato = lstKernelVecchi.Text
  
  ' 2. Se NON ha selezionato nulla dalla lista, prendiamo i dati dal kernel attuale (lblKernelAttuale)
  If sKernelSelezionato = "" Then
    ' Supponendo che lblKernelAttuale contenga del testo tipo "Kernel in uso: 6.12.105+deb13-amd64" 
    ' o direttamente la versione, estraiamo la stringa pulita.
    sVersioneAttuale = lblKernelAttuale.Text
    
 ripulisci_stringa:
    ' Se l'etichetta contiene scritte fisse, ripuliamo per lasciare solo la versione (es. 6.12.105+deb13-amd64)
    sVersioneAttuale = Replace(sVersioneAttuale, "Kernel in uso:", "")
    sVersioneAttuale = Trim(sVersioneAttuale)
    
    ' Fallback di sicurezza: se per caso il label è vuoto, usiamo uname -r
    If sVersioneAttuale = "" Then
      Shell "uname -r" To sVersioneAttuale
      sVersioneAttuale = Trim(sVersioneAttuale)
    End If
    
    If sVersioneAttuale = "" Then
      Message.Warning("Nessun kernel selezionato e impossibile rilevare il kernel attuale!")
      Return
    End If
    
    ' Troviamo il nome esatto del pacchetto installato corrispondente al kernel attuale
    Shell "dpkg -l | grep -E 'linux-image-[0-9]' | awk '{print $2}' | grep " & Quote(sVersioneAttuale) & " | head -n 1" To sKernelSelezionato
    sKernelSelezionato = Trim(sKernelSelezionato)
    
    ' Fallback se il dpkg non trova il pacchetto esatto
    If sKernelSelezionato = "" Then
      sKernelSelezionato = "linux-image-" & sVersioneAttuale
    End If
  Endif
  
  txtLog.Text = "Ricerca del changelog per il kernel attuale (" & sKernelSelezionato & ")..."
  
  ' 3. Cerchiamo il file di changelog associato al pacchetto
  Shell "dpkg -L " & Quote(sKernelSelezionato) & " 2>/dev/null | grep -E 'changelog.(Debian|gz)'" To sOutput
  
  ' Se dpkg non restituisce il percorso esatto, proviamo a cercarlo nella cartella doc
  If Trim(sOutput) = "" Then
    sChangelogPath = "/usr/share/doc/" & sKernelSelezionato & "/changelog.Debian.gz"
  Else
    sChangelogPath = Trim(sOutput)
  Endif
  
  ' 4. Se il file esiste, lo leggiamo (gestendo file compressi .gz o testo normale)
  If Exist(sChangelogPath) Then
    If Right(sChangelogPath, 3) = ".gz" Then
      Shell "zcat " & Quote(sChangelogPath) & " | head -n 100" To sOutput
    Else
      Shell "head -n 100 " & Quote(sChangelogPath) To sOutput
    Endif
  Else
    sOutput = ""
  Endif
  
  ' 5. Mostriamo il risultato nella txtLog
  If Trim(sOutput) = "" Then
    txtLog.Text = "Nessun changelog locale trovato per il kernel " & sKernelSelezionato & "."
  Else
    txtLog.Text = sOutput
  Endif

End
Public Sub btnAnteprima_Click()
  
  Dim sGrubCfg As String
  Dim sLine As String
  Dim sMenuEntries As String = ""
  Dim aLines As String[]
  Dim iCont As Integer = 1
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sTempFile As String = "/tmp/grub_preview_temp"
  
  ' 1. Verifichiamo se esiste la password salvata nelle impostazioni
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif
  
' 2. Copia sicura del file protetto usando la password di root (se disponibile)
  If sPassword <> "" Then
    ' Eseguiamo cp e chmod in un unico blocco protetto da un solo comando sudo
    Dim sFullCmd As String = "cp /boot/grub/grub.cfg " & sTempFile & " && chmod 644 " & sTempFile
    'Dim sCmd As String = "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sFullCmd)
    Dim sCmd As String = "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sFullCmd) & " 2>/dev/null"
    Shell "/bin/sh -c " & Shell(sCmd) Wait
  Endif
  
  ' 3. Leggiamo il file
  If Exist(sTempFile) Then
    Try sGrubCfg = File.Load(sTempFile)
    
    ' ⭐ CORRETTO: Eliminiamo il file temporaneo usando sudo se è di root, 
    ' oppure usiamo Shell con sudo per pulirlo senza generare eccezioni
    If sPassword <> "" Then
      Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S rm -f " & sTempFile) Wait
    Else
      Try Kill sTempFile
    Endif
  Else
    If Not Exist("/boot/grub/grub.cfg") Then
      Message.Warning("Il file /boot/grub/grub.cfg non esiste. Esegui prima un aggiornamento di GRUB.")
      Return
    Endif
    Try sGrubCfg = File.Load("/boot/grub/grub.cfg")
  Endif
  ' 4. Controllo finale errori di lettura o permessi
  If Error Or sGrubCfg = "" Then
    Message.Error("Impossibile leggere il file GRUB.\n\nAssicurati di aver salvato correttamente la password di root nelle impostazioni generali del programma.")
    Return
  Endif
  
  ' 5. Analisi delle voci del file GRUB
  aLines = Split(sGrubCfg, "\n")
  
  For Each sLine In aLines
    If InStr(sLine, "menuentry ") > 0 Then
      Dim iStart As Integer = InStr(sLine, "'")
      If iStart = 0 Then iStart = InStr(sLine, "\"")
      
      If iStart > 0 Then
        Dim sTitolo As String = Mid(sLine, iStart + 1)
        Dim iEnd As Integer = InStr(sTitolo, "'")
        If iEnd = 0 Then iEnd = InStr(sTitolo, "\"")
        If iEnd > 0 Then sTitolo = Left(sTitolo, iEnd - 1)
        
        sMenuEntries &= "  " & iCont & ". " & sTitolo & "\n"
        iCont += 1
      Endif
    Endif
  Next
  
  ' 6. Creazione e visualizzazione della finestra di anteprima (con sola X)
  Dim hDlg As Form = New Form As "FiltroDlg"
  hDlg.W = 750
  hDlg.H = 450
  hDlg.Text = "Anteprima Schermata di Avvio GRUB"
  hDlg.Border = True 
  hDlg.Resizable = False
  hDlg.Utility = True
  
  Dim hTxt As TextArea = New TextArea(hDlg)
  hTxt.X = 10
  hTxt.Y = 10
  hTxt.W = hDlg.W - 35
  hTxt.H = hDlg.H - 60
  hTxt.Background = Color.Black
  hTxt.Foreground = Color.LightGray
  hTxt.Font = Font["Monospace,10"]
  
  Dim sSimulazioneBoot As String = "========================================================================\n"
  sSimulazioneBoot &= "                          GNU GRUB  v2.12                               \n"
  sSimulazioneBoot &= "========================================================================\n\n"
  If sMenuEntries <> "" Then
    sSimulazioneBoot &= sMenuEntries
  Else
    sSimulazioneBoot &= "  (Nessuna voce di menu trovata)\n"
  Endif
  sSimulazioneBoot &= "\n------------------------------------------------------------------------\n"
  sSimulazioneBoot &= "Usa i tasti freccia su/giù per selezionare la voce, premi Invio per avviare.\n"
  
  hTxt.Text = sSimulazioneBoot
  
  ' Mostriamo la finestra in modo modale
  hDlg.ShowModal()

End


