  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sComando As String

  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  If lstServizi.Index = -1 Then 
    Message.Error("Seleziona prima un servizio!")
    Return
  Endif

  Dim sServizio As String = lstServizi.Text
  Dim sGruppoOttimizzati As String[] = ["ModemManager.service", "smartmontools.service", "NetworkManager-wait-online.service"]

  ' 2. Caso A: È un servizio del gruppo ottimizzato
  If sGruppoOttimizzati.Exist(sServizio) Then
