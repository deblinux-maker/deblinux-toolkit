  comando = "tar -czf " & Shell(percorsoScelto) & " /etc/apt/sources.list /etc/apt/sources.list.d/ /etc/apt/trusted.gpg.d/ && chmod 777 " & Shell(percorsoScelto)

  If sPassword <> "" Then
    Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(comando)) Wait
  Else
    Shell "pkexec sh -c " & Shell(comando) Wait
  End If

  ' Controlla il file
  If Exist(percorsoScelto) And Stat(percorsoScelto).Size > 50 Then
    txtlog.Text &= ("[SUCCESSO] Backup completato con successo in: ") & percorsoScelto & "\n"
    Message.Info("Backup dei repository completato con successo!", "OK")
  Else
    txtlog.Text &= ("[ERRORE] Il file non è stato creato correttamente o operazione annullata.\n")
  End If

End Sub

