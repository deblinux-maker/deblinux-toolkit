Public Sub btnIdentifica_Click()
  Dim sModello As String
  Dim aDati As String[]
  Dim bIsSSD As Boolean = False
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sOutputSMART As String
  Dim sRota As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  If Not VerificaSmartmontools() Then Return
  
  If sNomeDispositivo = "" Then  
      Message.Error("Seleziona prima un disco dalla lista!")
      Return
  Endif
  
  ' 2. Controllo pulito con lsblk usando il flag -d (restituisce un'unica riga per il disco)
  Shell "lsblk -d -no rota /dev/" & sNomeDispositivo To sRota
  sRota = Trim(sRota)
  
  If sRota = "0" Then
     bIsSSD = True
  Else
     bIsSSD = False
  Endif
  
  ' 3. Esecuzione SMART per i dati di utilizzo
  Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- /usr/sbin/smartctl -A /dev/" & sNomeDispositivo) To sOutputSMART
  
  If Trim(sOutputSMART) = "" Or InStr(sOutputSMART, "a password is required") > 0 Then Return  
  
  ' 4. Recupero modello
  Shell "cat /sys/block/" & sNomeDispositivo & "/device/model" To sModello
  sModello = Trim(sModello)
  If sModello = "" Then sModello = "Dispositivo " & sNomeDispositivo
  
  ' 5. Analisi dati SMART
  aDati = AnalizzaDatiSMART(sOutputSMART)
  
  ' DEBUG: Mostra cosa ha rilevato esattamente il programma
  'If bIsSSD = True Then
  '   Message.Info("DEBUG: bIsSSD è TRUE (SSD)\nValore letto da lsblk: [" & sRota & "]")
  'Else
  '   Message.Info("DEBUG: bIsSSD è FALSE (HDD)\nValore letto da lsblk: [" & sRota & "]")
  'Endif
  
  ' 6. Aggiornamento interfaccia in base alla rilevazione
  txtReportDisco.Clear
  txtReportDisco.Text = "--- STATO DEL TUO DISCO ---\n"
  txtReportDisco.Text &= "Modello: " & sModello & "\n"
  txtReportDisco.Text &= "🕒 Ore di utilizzo: " & aDati[0] & "\n"
  
  If bIsSSD Then
     txtReportDisco.Text &= "💾 Dati scritti (Host): " & aDati[1] & "\n"
     txtReportDisco.Text &= "📉 Usura reale (NAND): " & aDati[2] & "\n"
  Else
     txtReportDisco.Text &= "💾 Tipo disco: HDD (Meccanico)\n"
     txtReportDisco.Text &= "🚀 Stato: Ottimizzazione non necessaria\n"
  Endif

  ' 7. Analisi salute automatica
  EseguiControlloSalute(sOutputSMART)
End
Public Sub EseguiControlloSalute(sInput As String)
  Dim sRiallocati As String = "0"
  Dim sCRC As String = "0"
  
  For Each sRiga As String In Split(sInput, "\n")
    If InStr(sRiga, "5 Reallocated_Sector_Ct") Then sRiallocati = Split(sRiga, " ", "", True)[Split(sRiga, " ", "", True).Max]
    If InStr(sRiga, "199 SATA_CRC_Error") Then sCRC = Split(sRiga, " ", "", True)[Split(sRiga, " ", "", True).Max]
  Next
  
  If sRiallocati = "0" And sCRC = "0" Then
     lblStatoDisco.Text = "Stato: OTTIMO"
     lblStatoDisco.Foreground = Color.Green
  Else
     lblStatoDisco.Text = "Stato: ATTENZIONE (Settori: " & sRiallocati & " | CRC: " & sCRC & ")"
     lblStatoDisco.Foreground = Color.Red
  Endif
End
Public Sub AnalizzaDatiSMART(sInput As String) As String[]
  Dim aRisultati As New String[]
  Dim sRiga As String
  Dim aParti As String[]
  Dim fGiB As Float
  Dim sOre As String = "N/A"
  Dim sScritture As String = "N/A"
  Dim sUsura As String = "N/A"
  
  ' Inizializziamo con valori predefiniti
  aRisultati.Add("N/A") ' [0] Ore
  aRisultati.Add("N/A") ' [1] Scritture
  aRisultati.Add("N/A") ' [2] Usura / Info extra
  
  ' CONTROLLO PROTOCOLLO: NVMe o SATA?
  If InStr(sInput, "NVMe") Then
     ' --- LOGICA PER NVMe (Standard universale) ---
     For Each sRiga In Split(sInput, "\n")
        If InStr(sRiga, "power_on_hours:") Then  
           sOre = Trim(Replace(sRiga, "power_on_hours:", ""))
        Endif
        If InStr(sRiga, "data_units_written:") Then  
           sScritture = Trim(Replace(sRiga, "data_units_written:", ""))
        Endif
     Next
     aRisultati[0] = sOre
     aRisultati[1] = sScritture
     aRisultati[2] = "Protocollo: NVMe (Ottimizzato)"
     
  Else
     ' --- LOGICA UNIVERSALE SATA (Legge per nome e ID descrittivo) ---
     For Each sRiga In Split(sInput, "\n")
        aParti = Split(sRiga, " ", "", True)
        If aParti.Count < 2 Then Continue
        
        ' 1. Ore di accensione (Cerca la parola Power_On_Hours o l'ID 9)
        If InStr(sRiga, "Power_On_Hours") Or (aParti[0] = "9" And aParti.Count >= 10) Then
           sOre = aParti.Last
        Endif
        
        ' 2. Dati scritti (Cerca Total_LBAs_Written, 241, o descrizioni simili di scrittura host)
        If InStr(sRiga, "Total_LBAs_Written") Or InStr(sRiga, "Host_Writes") Or (aParti[0] = "241") Then
           If aParti.Count >= 10 Then
              ' I settori sono da 512 byte -> Convertiamo in GiB dividendo per 2097152
              Try fGiB = Val(aParti.Last) / 2097152
              If Not Error And fGiB > 0 Then
                 sScritture = Format(fGiB, "#,##0.02") & " GiB"
              Endif
           Endif
        Endif
        
        ' 3. Usura o stato NAND (Cerca Wear_Range_Delta, Media_Wearout_Indicator, o ID 233 / 202)
        If InStr(sRiga, "Wearout") Or InStr(sRiga, "Wear_Leveling_Count") Or InStr(sRiga, "Percent_Lifetime_Used") Or (aParti[0] = "233") Then
           If aParti.Count >= 10 Then
              sUsura = aParti.Last & " (Indicatore SSD)"
           Endif
        Endif
     Next
     
     ' Assegniamo i risultati trovati
     aRisultati[0] = sOre
     aRisultati[1] = IIf(sScritture = "N/A", "Non disponibile per questo modello", sScritture)
     aRisultati[2] = IIf(sUsura = "N/A", "Normale (Nessun allarme critico)", sUsura)
  Endif
  
  Return aRisultati
End

