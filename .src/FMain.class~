Public Sub LeggiZramDaProc()
  Dim sLinea, sDati As String
  Dim aPezzi As String[]
  Dim bAttiva As Boolean = False
  Dim fTotale, fUsato As Float
If bInTransizione Then Return
  ' 1. Verifichiamo il file
  If Not Exist("/proc/swaps") Then Return

  ' 2. Leggiamo tutto il file in una volta sola
  sDati = File.Load("/proc/swaps")

  For Each sLinea In Split(sDati, "\n")
    ' Se la riga contiene zram, la analizziamo
    If InStr(sLinea, "/dev/zram") > 0 Then
      bAttiva = True
      
      ' --- PULIZIA SPAZI (Fondamentale!) ---
      sLinea = Replace(sLinea, "\t", " ") ' Trasforma i Tab in spazi
      While InStr(sLinea, "  ") > 0       ' Finché ci sono doppi spazi...
        sLinea = Replace(sLinea, "  ", " ") ' ...falli diventare singoli
      Wend
      
      aPezzi = Split(Trim(sLinea), " ")

      ' Ora aPezzi sarà: [0]/dev/zram0 [1]partition [2]Size [3]Used [4]Priority
      If aPezzi.Count >= 4 Then
        fTotale = Val(aPezzi[2]) / 1024 
        fUsato = Val(aPezzi[3]) / 1024   
        
        ' ⭐ CORREZIONE: Aggiorna lo slider SOLO se è abilitato (evita loop di eventi)
        If sldZramSize.Enabled Then
          sldZramSize.Value = Round(fTotale, 0)
        Endif
        
        ' Aggiorna la barra (es: 652 / 2200)
        If fTotale > 0 Then ProgressBarZram.Value = fUsato / fTotale
        lblZramInfo.Text = ("Utilizzo: ") & Round(fUsato, 0) & " MB / " & Round(fTotale, 0) & " MB"
      Endif
    Endif
  Next

  ' 3. Aggiornamento interfaccia in base allo stato
  If bAttiva Then
    btnToggleZram.Text = ("Disattiva zRAM")
    btnToggleZram.Foreground = Color.White
    btnAutoConfig.Enabled = False
    sldZramSize.Enabled = False
    
    ' Carichiamo l'algoritmo
    If Exist("/sys/block/zram0/comp_algorithm") Then
       Dim sAlgo As String = File.Load("/sys/block/zram0/comp_algorithm")
       ' Estraiamo quello tra le parentesi [ ]
       If InStr(sAlgo, "[") > 0 Then
          lblAlgo.Text = "Algoritmo: " & Mid(sAlgo, InStr(sAlgo, "[") + 1, InStr(sAlgo, "]") - InStr(sAlgo, "[") - 1)
       Else
          lblAlgo.Text = "Algoritmo: " & Trim(sAlgo)
       Endif
    Endif
  Else
    btnToggleZram.Text = "Attiva zRAM"
    btnToggleZram.Foreground = Color.White
    lblZramInfo.Text = "Stato: zRAM non attiva"
    ProgressBarZram.Value = 0
    lblAlgo.Text = "Algoritmo: ---"
    btnAutoConfig.Enabled = True
    sldZramSize.Enabled = True
  Endif
' Assegna il valore massimo calcolato dalla RAM di sistema alla label
'lblZramMax.Text = iRamSistemaMB & " MB"
End

Public Sub ImpostaDefaultZram()
  Dim sDati As String
  Dim aRighe As String[]
  Dim iRamTotaleKB As Long
  Dim iSuggeritoMB As Integer

  ' 1. Leggiamo il file di sistema della memoria
  If Exist("/proc/meminfo") Then
    sDati = File.Load("/proc/meminfo")
    aRighe = Split(sDati, "\n")
    
    ' 2. Estraiamo i KB dalla prima riga (MemTotal) usando Scan
    If aRighe.Count > 0 Then
      Try iRamTotaleKB = Val(Scan(aRighe[0], "*:*kB")[1])
      If Error Then Return
      
      ' 3. Convertiamo in MB e calcoliamo il 50%
      iSuggeritoMB = Round((iRamTotaleKB / 1024) / 2, 0)
      
      ' 4. Impostiamo lo slider al valore suggerito automatico
      If iSuggeritoMB >= sldZramSize.MinValue And If iSuggeritoMB <= sldZramSize.MaxValue Then
        sldZramSize.Value = iSuggeritoMB
      Endif
    Endif
  Endif
End

