Public Sub btnSalvaGrub_Click()
  $iInEsecuzione = 1
  Dim sPercorso As String = "/etc/default/grub"
  Dim sTmpFile As String = "/tmp/deblinux_grub_edit.tmp"
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sCmd As String
  
  ' 1. Verifichiamo la password
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nSalva prima la password di root nelle impostazioni generali.")
    Return
  Endif

  ' 2. Salviamo il testo del TextArea nel file temporaneo
  If Exist(sTmpFile) Then Try Kill sTmpFile
  File.Save(sTmpFile, txtGrub.Text)
  Wait 0.05

  ' 3. Svuotiamo preventivamente il testo per capire se arriva alla fine
  txtGrub.Text = ""

  ' 4. Eseguiamo il comando di copia e aggiornamento tramite Shell in modo sincrono
  ' Usiamo echo con -e o passiamo la password in modo sicuro
  sCmd = "echo " & Shell(sPassword) & " | sudo -S cp " & Shell(sTmpFile) & " " & sPercorso & " && echo " & Shell(sPassword) & " | sudo -S chmod 644 " & sPercorso & " && echo " & Shell(sPassword) & " | sudo -S update-grub"
  
  Shell "/bin/sh -c " & Shell(sCmd) Wait

  ' Pulizia file temporaneo
  If Exist(sTmpFile) Then Try Kill sTmpFile

  ' 5. Ricarichiamo la configurazione aggiornata (o mostriamo il file reale)
  CaricaConfigGrub()
  $iInEsecuzione = 0
  Message.Info("Procedura di salvataggio e aggiornamento completata!")
End
' --- Pulsante Ripristina Backup (opzionale ma consigliato) ---
Public Sub btnRipristinaGrub_Click()
  $iInEsecuzione = 1
  Dim hProc As Process
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  If Message.Question("Vuoi ripristinare il file GRUB originale dal backup di sistema?", "Sì", "No") = 2 Then Return
  
  ' Esegue il ripristino se esiste un file di backup standard (.bak)
  Dim sCmd As String = "if [ -f /etc/default/grub.bak ]; then cp /etc/default/grub.bak /etc/default/grub && update-grub; else echo 'Backup non trovato'; exit 1; fi"
  
  ' 2. Avvio del processo sfruttando la password salvata (tramite sudo -S)
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sCmd)] For Read As "ProcGrubBak"
  
  If Error Or If Not hProc Then
    Message.Error("Impossibile eseguire il ripristino.")
    Return
  Endif
  
' Attende la fine del processo
  While hProc.State = Process.Running
    Wait 0.05
  Wend

  If hProc.Value = 0 Then
    Message.Info("Backup ripristinato con successo!")
    CaricaConfigGrub()
  Else
    Message.Error("Nessun file di backup trovato o errore durante il ripristino.")
  Endif
  $iInEsecuzione = 0
End

