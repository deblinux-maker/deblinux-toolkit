Public Sub CaricaPorteAperte()
  
  Dim sLine As String
  Dim sOutput As String
  Dim sCol As String[]
  Dim iRow As Integer
  Dim sStatoAmichevole As String
  Dim sProtoAmichevole As String
  
  InizializzaTabellaPorte()
  
  Shell "ss -tulnp | tail -n +2" To sOutput
  
  For Each sLine In Split(sOutput, "\n")
    If Trim(sLine) = "" Then Continue
    
    sCol = Split(Trim(sLine), " ", "", True)
    
    If sCol.Max >= 4 Then
      gvPorte.Rows.Count += 1
      iRow = gvPorte.Rows.Max
      
      ' 1. Protocollo più leggibile
      sProtoAmichevole = UCase(sCol[0]) ' Es. TCP o UDP
      gvPorte[iRow, 0].Text = sProtoAmichevole
      
      ' 2. Traduciamo lo stato in modo comprensibile per un utente comune
      Select Case sCol[1]
        Case "LISTEN"
          sStatoAmichevole = "In ascolto (Aperta)"
        Case "UNCONN"
          sStatoAmichevole = "Attivo / Pronto"
        Case Else
          sStatoAmichevole = sCol[1]
      End Select
      gvPorte[iRow, 1].Text = sStatoAmichevole
      
      ' 3. Indirizzo e Porta
      gvPorte[iRow, 2].Text = sCol[4]
      
      ' 4. Programma (se presente, lo rendiamo più pulito)
      gvPorte[iRow, 3].Text = sCol[sCol.Max]
      
    End If
    
  Next

End
Public Sub btnScansionaPorte_Click()

  CaricaPorteAperte()

End

Public Sub btnFail2ban_Click()
  
  Dim sStatus As String
  Dim sInstalled As String
  Dim sDir As String = User.Home &/ ".config/deblinux_toolkit"
  Dim sConfFile As String = sDir &/ "config.conf"
  Dim sPassDecoded As String
  Dim sShellCmd As String
  
  ' 1. CONTROLLO INSTALLAZIONE: Verifichiamo se fail2ban è installato nel sistema
  Shell "which fail2ban-server" To sInstalled
  
  If Trim(sInstalled) = "" Then
    ' Se non è installato, chiediamo se vuole installarlo
    If Message.Question("Fail2ban non è installato sul tuo sistema. Vuoi installarlo ora?", "Sì", "No") = 1 Then
      
      ' Recuperiamo la password salvata o usiamo pkexec per l'installazione
      If Exist(sConfFile) Then
        Try sPassDecoded = UnBase64$(File.Load(sConfFile))
        If Not Error And sPassDecoded <> "" Then
          sShellCmd = "echo " & Shell(sPassDecoded) & " | sudo -S apt-get update && echo " & Shell(sPassDecoded) & " | sudo -S apt-get install -y fail2ban"
        Endif
      Endif
      
      If sShellCmd = "" Then
        sShellCmd = "pkexec apt-get update && pkexec apt-get install -y fail2ban"
      Endif
      
      ' Eseguiamo l'installazione
      Shell sShellCmd Wait
      
      ' Riverifichiamo se ora è installato
      Shell "which fail2ban-server" To sInstalled
      If Trim(sInstalled) = "" Then
        Message.Error("L'installazione non è andata a buon fine.")
        Return
      Endif
    Else
      Return
    Endif
  Endif
  
  ' 2. CONTROLLO STATO: Verifichiamo se il servizio è attivo
  Shell "systemctl is-active fail2ban" To sStatus
  
  If Trim(sStatus) = "active" Then
    Message.Info("La protezione Fail2ban è già attiva e sta monitorando il tuo sistema.")
    lblStatoFail2ban.Text = "Protezione Attiva"
    Return
  Endif
  
  ' 3. ATTIVAZIONE: Se è installato ma spento, chiediamo se vuole accenderlo
  If Message.Question("La protezione è installata ma disattivata. Vuoi attivarla ora?", "Sì", "No") <> 1 Then
    Return
  Endif
  
  sShellCmd = ""
  If Exist(sConfFile) Then
    Try sPassDecoded = UnBase64$(File.Load(sConfFile))
    If Not Error And sPassDecoded <> "" Then
      sShellCmd = "echo " & Shell(sPassDecoded) & " | sudo -S systemctl enable --now fail2ban"
    Endif
  Endif
  
  If sShellCmd = "" Then
    sShellCmd = "pkexec systemctl enable --now fail2ban"
  Endif
  
  ' Eseguiamo l'attivazione
  Shell sShellCmd Wait
  
  ' 4. VERIFICA FINALE
  Shell "systemctl is-active fail2ban" To sStatus
  
  If Trim(sStatus) = "active" Then
    lblStatoFail2ban.Text = "Protezione Attiva"
    Message.Info("Protezione attivata con successo! Ora il tuo sistema è protetto.")
  Else
    lblStatoFail2ban.Text = "Protezione Disattiva"
    Message.Info("Operazione annullata o password non valida. La protezione non è stata attivata.")
  Endif

End



