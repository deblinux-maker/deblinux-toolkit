Public Sub btnUpdate_Click()
  $iInEsecuzione = 1
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
     Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
     Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
     Return
  Endif

  ' 2. Disabilitiamo temporaneamente il pulsante per evitare doppi clic
  btnUpdate.Enabled = False
  
  ' 3. Pulizia del log principale in basso
  txtLog.Clear
  txtLog.Insert("[SISTEMA] Avvio aggiornamento liste dei repository...\n")
  
  ' 4. Eseguiamo il comando sfruttando la password salvata (via sudo -S)
  Try hProc = Exec ["/bin/sh", "-c", "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- apt update 2>&1"] For Read As "AptUpdate"
  
  If Error Or If Not hProc Then
     Message.Error("Errore nell'avvio dell'aggiornamento: " & Error.Text)
     btnUpdate.Enabled = True
     Return
  Endif

  ' 5. Attiviamo il timer di controllo sul processo
  TimerControllo.Enabled = True
  $iInEsecuzione = 0
End
' 2. LA LETTURA (più fluida e sicura)
Public Sub AptUpdate_Read()
  Dim sOut As String
  
  ' Legge tutto ciò che è disponibile nel buffer
  Try Read #hProc, sOut, -256
  
  If Error Then Return ' Se ci sono problemi di lettura, esci
  
  If sOut Then
     txtLog.Insert(sOut)
     txtLog.Pos = txtLog.Length
  Endif
End

Public Sub AptUpdate_Terminate()
  ' Questa funzione scatta automaticamente quando hProc chiude
  ' Non chiamarla manualmente dalla Read!
  
  btnUpdate.Enabled = True
  txtLog.Insert("\n\n--- OPERAZIONE COMPLETATA ---\n")
  
  Message.Info("Aggiornamento repository terminato!")
End
