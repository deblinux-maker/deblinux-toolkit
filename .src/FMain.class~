Public Sub DisinstallaFlatpak()
  Dim i As Integer
  Dim iCount As Integer = 0
  Dim sMsg As String
  Dim aArgs As String[]
  Dim hProc As Process
  Dim sBuffer As String

  ' 1. Inizializziamo l'array con il comando base
  aArgs = ["flatpak", "uninstall", "-y"]

  ' 2. Raccogliamo tutti i pacchetti selezionati nella griglia
  For i = 0 To GridViewFlatpak.Rows.Count - 1
    If GridViewFlatpak.Rows[i].Selected Then
      aArgs.Add(GridViewFlatpak[i, 0].Text)
      iCount += 1
    Endif
  Next

  ' Verifica se c'è qualcosa da fare
  If iCount = 0 Then
    Message.Info("Nessun pacchetto Flatpak selezionato.")
    Return
  Endif

  ' 3. Messaggio di conferma
  If iCount = 1 Then
    sMsg = "Vuoi disinstallare 1 pacchetto Flatpak?"
  Else
    sMsg = "Vuoi disinstallare " & iCount & " pacchetti Flatpak?"
  Endif

  If Message.Question(sMsg, "Sì", "No") <> 1 Then Return

  ' 4. Reset log e barra
  ProgressBar3.Value = 0 
  TxtLog.Clear
  TxtLog.Text = "Rimozione di " & iCount & " pacchetti Flatpak in corso...\n"

  ' 5. Esecuzione sicura tramite array
  Try hProc = Exec aArgs For Read As "ProcessoFlatpak"

  If Error Or If Not hProc Then
    Message.Error("Impossibile avviare il processo di disinstallazione Flatpak.")
    Return
  Endif

  ' 6. Ciclo in tempo reale per leggere l'output nel log
  While hProc.State = Process.Running
    If Not Eof(hProc) Then
      Read #hProc, sBuffer, -2048
      TxtLog.Insert(sBuffer)
      TxtLog.EnsureVisible
    Endif
    Wait 0.05
  Wend

  ' 7. Controllo del risultato finale
  If hProc.Value = 0 Then
    TxtLog.Insert("\n[OK] Disinstallazione Flatpak completata con successo!\n")
    Message.Info("Pacchetti Flatpak disinstallati con successo!")
    ' Ricarica la lista aggiornata dei Flatpak
    CaricaPacchettiFlatpak()
  Else
    TxtLog.Insert("\n[ERRORE] Disinstallazione Flatpak fallita o interrotta.\n")
    Message.Error("La disinstallazione dei Flatpak ha riscontrato un errore.")
  Endif
End
Public Sub ProcessoFlatpak_Read()
