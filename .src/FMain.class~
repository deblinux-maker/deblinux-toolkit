  Dim LabelVal As String = ("CPU")
  Draw.Font.Size = 9
  Draw.Font.Bold = False
  Draw.Foreground = Color.LightGray
  Draw.Text(LabelVal, X - (Draw.TextWidth(LabelVal) / 2), Y + 8)
  
End Sub

