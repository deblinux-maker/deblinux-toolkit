Public Sub btnSwapOttimizza_Click()
  Dim sRamTotale As String
  Dim iRam As Integer
  Dim iSwappinessConsigliata As Integer
  Dim iSwappinessAttuale As Integer
  Dim iScelta As Integer
  Dim sRisultato As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sComando As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Leggiamo la RAM totale
  Shell "free -m | grep Mem | awk '{print $2}'" To sRamTotale
  iRam = Val(Trim(sRamTotale))
  
  ' 3. Leggiamo il valore attuale di swappiness
  Try Shell "cat /proc/sys/vm/swappiness" To sRisultato
  iSwappinessAttuale = Val(Trim(sRisultato))
  
  ' 4. Determiniamo il valore consigliato in base alla RAM
  If iRam >= 8000 Then
    iSwappinessConsigliata = 10
  Else If iRam >= 4000 Then
    iSwappinessConsigliata = 30
  Else
    iSwappinessConsigliata = 60
  Endif
  
  ' 5. Controllo: se è già ottimizzato, avvisiamo e usciamo
  If iSwappinessAttuale = iSwappinessConsigliata Then
    Message.Info(("Il sistema è già ottimizzato correttamente!") & "\n" & 
                 ("Il valore corrente è ") & iSwappinessAttuale & (", che è quello ideale per il tuo PC."), ("Chiudi"))
    Return
  Endif
  
  ' 6. Chiediamo conferma all'utente
  iScelta = Message.Question("Il tuo PC ha " & iRam & " MB di RAM.\n" &
                             "Il valore attuale di swappiness è " & iSwappinessAttuale & ".\n" &
                             "Consiglio di impostarlo a " & iSwappinessConsigliata & " per migliorare le prestazioni.\n\n" &
                             "Vuoi procedere?", "Ottimizza a " & iSwappinessConsigliata, "Annulla")
                             
  ' 7. Esecuzione (se l'utente conferma)
  If iScelta = 1 Then
    ' Usiamo tee per scrivere correttamente nel file di configurazione con i permessi di root
    sComando = "sysctl vm.swappiness=" & iSwappinessConsigliata & " && " &
               "echo 'vm.swappiness=" & iSwappinessConsigliata & "' | tee /etc/sysctl.d/99-deblinux-swappiness.conf > /dev/null"
    
    ' Esecuzione sfruttando la password salvata (tramite sudo -S)
    Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sComando)) Wait
    
    ' Verifichiamo il risultato
    If Exist("/etc/sysctl.d/99-deblinux-swappiness.conf") Then
        txtLogPerformance.Text = ("Successo: Swappiness impostata a " & iSwappinessConsigliata & " (Persistente).")
    Else
        txtLogPerformance.Text = ("Errore: Operazione fallita o permessi negati.")
    Endif
  Else
    txtLogPerformance.Text = ("Operazione annullata dall'utente.")
  Endif
End
