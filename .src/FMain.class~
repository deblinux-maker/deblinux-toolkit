Public Sub CaricaKernelManager()
  Dim sAttuale, sLista As String
  Dim aKernel As String[]
  Dim sElemento As String

  ' 1. Otteniamo il kernel in uso
  ' Trim è fondamentale perché uname aggiunge sempre un carattere di fine riga
  Shell "uname -r" To sAttuale
  sAttuale = Trim(sAttuale)
  lblKernelAttuale.Text = ("Kernel in uso: ") & sAttuale
  lblKernelAttuale.Font = Font["Bold"]

  ' 2. Cerchiamo i kernel installati
  ' Spiegazione comando Shell:
  ' grep '^ii' -> prende solo i pacchetti installati correttamente
  ' grep 'linux-image-[0-9]' -> prende i pacchetti kernel reali
  ' grep -v 'linux-image-amd64\|linux-image-686' -> ESCLUDE i meta-pacchetti generici
  ' grep -v ...sAttuale... -> Esclude quello che stai usando ora
  Shell "dpkg --list | grep '^ii' | grep 'linux-image-[0-9]' | grep -v 'linux-image-amd64\\|linux-image-686' | grep -v " & Quote(sAttuale) & " | awk '{print $2}'" To sLista
  
  lstKernelVecchi.Clear()
  
  ' Split con l'opzione True per eliminare le righe vuote automaticamente
  aKernel = Split(sLista, "\n", "", True)
  
  For Each sElemento In aKernel
    sElemento = Trim(sElemento)
    If sElemento <> "" Then 
      lstKernelVecchi.Add(sElemento)
    Endif
  Next

  ' 3. Gestione interfaccia (ti consiglio di de-commentarla)
  If lstKernelVecchi.Count = 0 Then
    lstKernelVecchi.Add("Nessun vecchio kernel trovato. Il sistema è pulito.")
    ' Se usi una ListBox, meglio disabilitarla se è solo un messaggio
    lstKernelVecchi.Enabled = False 
    btnPulisciKernel.Enabled = False
  Else
    lstKernelVecchi.Enabled = True
    btnPulisciKernel.Enabled = True
  Endif
End
