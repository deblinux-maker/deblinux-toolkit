Public Sub CaricaAppRepo()
  Dim sMainRepo As String = "/etc/apt/sources.list"
  Dim sDirRepo As String = "/etc/apt/sources.list.d/"
  Dim sFile As String
  Dim sContenuto As String

  txtRepo.Clear
  
  ' 1. Leggiamo il file principale
  If Exist(sMainRepo) Then
    sContenuto &= "--- FILE PRINCIPALE: " & sMainRepo & " ---\n"
    sContenuto &= File.Load(sMainRepo) & "\n\n"
  Endif
  
  ' 2. Leggiamo tutti i file extra nella cartella .d
  If Exist(sDirRepo) Then
    sContenuto &= "--- FILE AGGIUNTIVI (in " & sDirRepo & ") ---\n"
    For Each sFile In Dir(sDirRepo, "*.list")
      sContenuto &= "--- [" & sFile & "] ---\n"
      sContenuto &= File.Load(sDirRepo &/ sFile) & "\n\n"
    Next
  Endif
  
  ' 3. Mostriamo tutto nella TextArea
  If sContenuto = "" Then
    txtRepo.Text = ("Nessun repository trovato o file inaccessibile.")
  Else
    txtRepo.Text = sContenuto
  Endif
End
