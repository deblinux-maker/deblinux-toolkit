Public Sub EseguiAnalisiSistema()
  Dim hProc As Process
  Dim sComandoAnalisi As String
  
  Label32.Text = "Analisi del sistema in corso... Attendere."
  TxtLog2.Clear
  TxtLog2.Text &= "=== INIZIO ANALISI SISTEMA ===\n"
  sOutputAnalisi = ""
  
  ' Evidenziamo visivamente i controlli in corso
  LblStato1.Foreground = Color.Orange
  LblStato1.Text = "⏳ Analisi Cache di sistema..."
  
  ProgressBar2.Value = 0.2
  
  'sComandoAnalisi = "apt-get -s check; du -s /var/cache/apt/archives 2>/dev/null"
  sComandoAnalisi = "apt-get check 2>&1 || true; dpkg --audit"
  
  Try hProc = Exec ["/usr/bin/pkexec", "/bin/sh", "-c", sComandoAnalisi] For Read Write As "ProcessoAnalisi"
  
  If Error Then
    Message.Error("Errore durante l'avvio dell'analisi: " & Error.Text)
    Return
  Endif
  
  TxtLog2.Text &= "Analisi inviata al sistema...\n"
End

' 3. LETTURA OUTPUT ANALISI
Public Sub ProcessoAnalisi_Read()
  Dim sBuffer As String
  
  Read #Last, sBuffer, -256
  sOutputAnalisi &= sBuffer
  TxtLog2.Text &= sBuffer
End
Public Sub ProcessoAnalisi_Kill()
  
  ' Se il processo è stato chiuso dall'utente (es. password annullata), Last.Value sarà diverso da 0
If Last.Value <> 0 Then
    ProgressBar2.Value = 0
    Label32.Text = "Analisi annullata o errore di autenticazione."
    
    ' Reimpostiamo il testo originale e forziamo il colore bianco in modo che non sparisca sullo sfondo scuro
    LblStato1.Text = "• Pulizia Cache di sistema"
    LblStato1.Foreground = Color.White
    
    TxtLog2.Text &= "\n=== ANALISI ANNULLATA (Password non inserita o errata) ===\n"
    Return 
  Endif
  
  ' Se invece la password è stata inserita correttamente, prosegue con la normale analisi:
  ProgressBar2.Value = 100
  
  If iStatoPulsante = 1 Or InStr(sOutputAnalisi, "/var/cache/apt/archives") > 0 Then
    Label32.Text = "Il tuo sistema richiede attenzione. Trovati elementi da pulire!"
    Message.Warning("L'analisi ha rilevato elementi nella cache o file temporanei da ottimizzare.", "OK")
    
    ' Aggiorniamo l'etichetta per indicare che la cache richiede un intervento
    LblStato1.Foreground = Color.Orange
    LblStato1.Text = "⚠️ Cache di sistema da ripulire"
    
    button2.text = "Risolvi Problemi"
    iStatoPulsante = 1
  Else
    Label32.Text = "Il tuo sistema è in salute! Nessun problema rilevato."
    Message.Info("Analisi completata: il sistema è perfettamente pulito.", "OK")
    
    ' Se è tutto pulito, mettiamo la spunta verde
    LblStato1.Foreground = Color.Green
    LblStato1.Text = "✔ Cache di sistema pulita"
    
    button2.text = "Avvia Analisi Sistema"
    iStatoPulsante = 0
  Endif
  
  TxtLog2.Text &= "\n=== FINE ANALISI ===\n"
End

Public Sub EseguiPuliziaSistema()
  Dim hProcClean As Process
  Dim sComandoPulizia As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  Label32.Text = "Pulizia del sistema in corso..."
  TxtLog2.Clear
  TxtLog2.Text &= "=== INIZIO PULIZIA SICURA DEL SISTEMA ===\n"
  
  ProgressBar2.Value = 0.1
  
  ' Comando di pulizia sicuro che ignora i file temporanei bloccati in uso
  sComandoPulizia = "apt-get clean && apt-get autoclean && apt-get autoremove -y && rm -rf /tmp/* /var/tmp/* 2>/dev/null || true"
  ' Esecuzione asincrona tramite sudo -S
  Try hProcClean = Exec ["sh", "-c", "printf '%s\n' " & Shell$(sPassword) & " | sudo -S sh -c " & Shell$(sComandoPulizia)] For Read As "ProcessoPulizia"
  
  If Error Then
    Message.Error("Impossibile avviare la pulizia: " & Error.Text)
    Return
  Endif
  
  TxtLog2.Text &= "Comandi di pulizia inviati al sistema...\n"
End

Public Sub ProcessoPulizia_Read()
  Dim sBuffer As String
  
  ' Legge tutto ciò che è disponibile nel buffer in modo sicuro
  Read #Last, sBuffer, Lof(Last)
  TxtLog2.Text &= sBuffer
  TxtLog2.Pos = Len(TxtLog2.Text)
End

Public Sub ProcessoPulizia_Kill()
  
  TxtLog2.Text &= "\n[DEBUG] Codice di uscita pulizia (Last.Value) = " & Last.Value & "\n"
  
  ' Consideriamo 0 e 100 come esecuzioni riuscite con successo per evitare falsi allarmi al principiante
  If Last.Value <> 0 And Last.Value <> 100 Then
    ProgressBar2.Value = 0
    Label32.Text = "Errore durante la pulizia (Codice: " & Last.Value & ")"
    TxtLog2.Text &= "\n=== PULIZIA ANNULLATA O FALLITA ===\n"
    Message.Error("La pulizia ha riscontrato un problema imprevisto.", "OK")
    Return
  Endif
  
  ProgressBar2.Value = 100
  Label32.Text = "Ottimizzazione completata con successo!"
  
  ' AGGIORNA SUBITO LE ETICHETTE DEI MB LIBERATI
  Analizza()
  
  Message.Info("Il sistema è stato pulito e ottimizzato correttamente in totale sicurezza!", "Ottimo")
  
  LblStato1.Text = "• Pulizia Cache di sistema"
  LblStato1.Foreground = Color.White
  
  button2.Text = "Avvia Analisi Sistema"
  iStatoPulsante = 0
  TxtLog2.Text &= "\n=== FINE PULIZIA ===\n"
End

Public Sub AggiornaCardPulizia()
  Dim sCache As String
  Dim sCestino As String
  
  ' Esegue un comando per calcolare lo spazio occupato dalla cache di apt
  Shell "du -sh /var/cache/apt/archives 2>/dev/null | awk '{print $1}'" To sCache
  sCache = Trim(sCache)
  If sCache = "" Then sCache = "0 MB"

  ' Esegue un comando per calcolare lo spazio occupato dal Cestino
  Shell "du -sh ~/.local/share/Trash 2>/dev/null | awk '{print $1}'" To sCestino
  sCestino = Trim(sCestino)
  If sCestino = "" Then sCestino = "0 MB"
  
  ' Assegna i valori alle due etichette dentro la card
  lblStatoPulizia.Text = ("Spazio cache APT: ") & sCache
  lblCestino.Text = ("Spazio Cestino: ") & sCestino
End
Public Sub AggiornaCardStato()
  Dim sKernel As String
  Dim sUptimeFile As String
  Dim aParts As String[]
  Dim lSeconds As Long
  Dim sUptimeFormatted As String
  Dim iHours As Integer, iMinutes As Integer
  
  ' 1. Legge la versione del kernel in uso
  Shell "uname -r" To sKernel
  sKernel = Trim(sKernel)
  
  ' 2. Legge e calcola l'uptime da /proc/uptime (usando Split per evitare problemi di locale)
  If Exist("/proc/uptime") Then
    sUptimeFile = File.Load("/proc/uptime")
    If sUptimeFile Then
      aParts = Split(Trim(sUptimeFile), " ")
      If aParts.Max >= 0 And If aParts[0] Then
        ' Prende la parte intera prima del punto, indipendente da qualsiasi lingua
        lSeconds = CLong(Split(aParts[0], ".")[0])
      Else
        lSeconds = 0
      End If
    End If
  End If
  
  ' 3. Converte i secondi in formato leggibile (reintegrando la variabile che mancava)
  iHours = lSeconds \ 3600
  iMinutes = (lSeconds Mod 3600) \ 60
  sUptimeFormatted = iHours & "h " & iMinutes & "m"
  
  ' 4. Assegna i valori corretti alle etichette dentro la card
  lblKernel.Text = ("Kernel: ") & sKernel
  lblUptimeCard.Text = ("Uptime: ") & sUptimeFormatted
  
End Sub
Public Sub Analizza()
  Dim sTotApp As String
  Dim sTotCestino As String
  Dim sTotSys As String
  Dim sTotApt As String
  Dim sTotLog As String
  
' 1. Calcola solo le cache reali dei browser e delle miniature (escludendo font e appstream)
  Shell "du -sm ~/.cache/mozilla ~/.cache/google-chrome ~/.cache/chromium ~/.cache/BraveSoftware ~/.cache/opera ~/.cache/microsoft-edge ~/.cache/vivaldi ~/.cache/thumbnails 2>/dev/null | awk '{sum+=$1} END {if (sum<2) print 0; else print sum}'" To sTotApp
  LblSpazioApp.Text = Trim(sTotApp) & " MB"
  
' 2. Cestino e Registri utente (Cestino + file .log reali nella cache)
  Shell "du -sm ~/.local/share/Trash 2>/dev/null | awk '{sum+=$1} END {if (sum<2) print 0; else print sum}'" To sTotCestino
  
  ' Calcoliamo i file .log effettivi presenti nella cache
  Shell "find ~/.cache -name '*.log' -exec du -sm {} + 2>/dev/null | awk '{sum+=$1} END {print sum+0}'" To sTotLog
  
  ' Sommiamo solo il cestino e i log trovati (SENZA +13 fissi)
  Dim iTotCestinoLog As Integer = Val(Trim(sTotCestino)) + Val(Trim(sTotLog))
  LblSpazioCestino.Text = iTotCestinoLog & " MB"
  
  ' 3. Sistema e Temporanei (File eliminabili in /tmp)
  Shell "find /tmp -mindepth 1 -maxdepth 1 ! -name 'gambas.*' ! -name '.*-unix' 2>/dev/null | wc -l" To sTotSys
  If Val(Trim(sTotSys)) = 0 Then
    LblSpazioSys.Text = "0 MB"
  Else
    Shell "find /tmp -mindepth 1 -maxdepth 1 ! -name 'gambas.*' ! -name '.*-unix' -exec du -sm {} + 2>/dev/null | awk '{sum+=$1} END {if (sum<2) print 0; else print sum}'" To sTotSys
    If Trim(sTotSys) = "" Or Trim(sTotSys) = "0" Then
      LblSpazioSys.Text = "0 MB"
    Else
      LblSpazioSys.Text = Trim(sTotSys) & " MB"
    Endif
  Endif
  
  ' 4. Pacchetti e APT
  Shell "du -sm /var/cache/apt/archives 2>/dev/null | awk '{sum+=$1} END {if (sum<2) print 0; else print sum}'" To sTotApt
  LblSpazioApt.Text = Trim(sTotApt) & " MB"
  
Catch
  LblSpazioApp.Text = "0 MB"
  LblSpazioCestino.Text = "0 MB"
  LblSpazioSys.Text = "0 MB"
  LblSpazioApt.Text = "0 MB"
End
Public Sub btnAnalizza1_Click()
   $iInEsecuzione = 1
   Dim sOutput As String
   Dim sStatoServizi As String
   Dim sPercentuale As String
   Dim iErrori As Integer
   Dim iPing As Integer
   Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
   Dim sPassword As String
   
   ' Verifichiamo se la password è salvata (necessaria per le azioni correttive successive)
   If Exist(sConfFile) Then
     Try sPassword = FromBase64$(File.Load(sConfFile))
   Endif
   
   ' Reset tabella diagnostica
   gvDiagnostica.Clear
   gvDiagnostica.Rows.Count = 5
   gvDiagnostica.Columns.Count = 2
   
   ' 1. Integrità Database APT
   Shell "apt-get check" Wait To sOutput
   If Trim(sOutput) = "" Then
      gvDiagnostica[0, 0].Text = ("Database Pacchetti")
      gvDiagnostica[0, 1].Text = ("✅ Integro")
   Else
      gvDiagnostica[0, 1].Text = ("⚠️ Problemi trovati (Clicca per riparare)")
      If Message.Question("Il database APT presenta problemi. Vuoi risolverli ora?", "Sì", "No") = 1 Then
         If sPassword = "" Then
           Message.Warning("Questa operazione correttiva richiede che la password di root sia salvata nelle impostazioni generali.")
           Return
         Endif
         
         Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- apt-get install -f -y") Wait
         Message.Info("Riparazione database completata.")
         Me.BtnAnalizza1_Click()
         Return
      Endif
   Endif
   
   ' 2. Connessione Internet
   Shell "ping -c 1 8.8.8.8 > /dev/null 2>&1" Wait
   iPing = Last.Value 
   gvDiagnostica[1, 0].Text = ("Connessione Internet")
   gvDiagnostica[1, 1].Text = IIf(iPing = 0, ("✅ Attiva"), ("❌ Offline"))

   ' 3. Stato Servizi
   Shell "systemctl is-system-running" Wait To sOutput
   sStatoServizi = Trim(sOutput)
   gvDiagnostica[2, 0].Text = ("Stato Servizi")
   gvDiagnostica[2, 1].Text = sStatoServizi

   If sStatoServizi = "degraded" Then
      If Message.Question("Il sistema segnala servizi degradati. Vuoi visualizzare i dettagli o resettarli?", "Visualizza", "Pulisci") = 1 Then
         MManutenzione.ElencaServiziRunning(txtLog2)
      Else
         If sPassword = "" Then
           Message.Warning("Questa operazione correttiva richiede che la password di root sia salvata nelle impostazioni generali.")
           Return
         Endif
         
         Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- systemctl reset-failed") Wait
         Message.Info("Reset servizi completato.")
         Me.BtnAnalizza1_Click()
         Return
      Endif
   Endif

   ' 4. Uso Disco (Root)
   Shell "df -h / | awk 'NR==2 {print $5}'" Wait To sOutput
   sPercentuale = Trim(sOutput)
   gvDiagnostica[3, 0].Text = ("Uso Disco (Root)")
   gvDiagnostica[3, 1].Text = sPercentuale

   If Val(Replace(sPercentuale, "%", "")) > 90 Then
      gvDiagnostica[3, 1].Foreground = Color.Red
      gvDiagnostica[3, 1].Font.Bold = True
      
      If Message.Warning("Spazio disco critico (>90%)! Vuoi avviare la pulizia rapida?", "Pulisci Ora", "Salta") = 1 Then
         MManutenzione.MostraErroriKernel(txtLog2)
         MManutenzione.ElencaServiziRunning(txtLog2)
         MManutenzione.VerificaDatabase(txtLog2, User.Home & "/.deblinux_toolkit.db")
         MManutenzione.EseguiPuliziaDisco(txtLog2)
         MManutenzione.AnalizzaDoveSiaLoSpazio(txtLog2)
         MManutenzione.DiagnosticaSpazio(txtLog2)
         Me.BtnAnalizza1_Click()
         Return
      Endif
   Endif

   ' 5. Errori Kernel
   Shell "dmesg -l err | wc -l" Wait To sOutput
   iErrori = Val(Trim(sOutput))
   gvDiagnostica[4, 0].Text = ("Errori Kernel")
   gvDiagnostica[4, 1].Text = IIf(iErrori = 0, ("✅ Nessuno"), "⚠️ " & iErrori & (" avvisi"))

   If iErrori > 0 Then
      If Message.Question("Rilevati errori del kernel (" & iErrori & "). Vuoi visualizzarli o pulire i log?", "Visualizza", "Pulisci Log") = 1 Then
         Shell "dmesg -l err | tail -n 20 > /tmp/errori.txt" Wait
         Shell "xdg-open /tmp/errori.txt"
      Else
         If sPassword = "" Then
           Message.Warning("Questa operazione correttiva richiede che la password di root sia salvata nelle impostazioni generali.")
           Return
         Endif
         
         Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- dmesg -C") Wait
         Message.Info("Log del kernel puliti!")
         Me.BtnAnalizza1_Click()
         Return
      Endif
   Endif

   ' Stato Salute Finale
   If iErrori > 0 Or sStatoServizi <> "running" Or Val(Replace(sPercentuale, "%", "")) > 90 Then
      lblStatoSalute.Text = ("● Sistema richiede attenzione")
      lblStatoSalute.Foreground = Color.RGB(255, 80, 80)
   Else
      lblStatoSalute.Text = ("● Sistema in ottima salute")
      lblStatoSalute.Foreground = Color.Green
   Endif
   
   gvDiagnostica.Columns[0].Width = 240
   gvDiagnostica.Columns[1].Expand = True
$iInEsecuzione = 0
End

