Public Sub btnEseguiDistruzione_Click()
  Dim sFile As String = TextBoxFile.Text

  ' Controllo: se la casella è vuota
  If sFile = "" Then
    Message.Warning("Prima seleziona un file da distruggere!")
    Return
  Endif

  ' Controllo di sicurezza: Il file deve trovarsi tassativamente nella Home dell'utente
  If InStr(sFile, User.Home) <> 1 Then
    Message.Error("Per motivi di sicurezza, puoi distruggere solo file presenti all'interno della tua Home!")
    Return
  Endif

  ' Controllo che il file esista davvero
  If Not Exist(sFile) Then
    Message.Error("Il file selezionato non esiste o è stato già rimosso.")
    Return
  Endif

  ' MESSAGGIO DI ALLERTA CRITICO (Azione Irreversibile)
  If Message.Question("ATTENZIONE:\nQuesta operazione sovrascriverà i dati del file più volte e lo cancellerà in modo DEFINITIVO e IRRECUPERABILE.\n\nVuoi procedere davvero?", "Annulla", "Distruggi per sempre") = 2 Then
    
    ' Eseguiamo il comando Linux shred:
    ' -u = cancella/rimuove il file dopo la sovrascrittura
    ' -n 3 = effettua 3 passate di sovrascrittura con dati casuali
    ' -z = aggiunge un'ultima passata di zeri per mascherare la pulizia
    Dim sComando As String = "shred -u -n 3 -z " & Shell(sFile)
    
    Try Shell sComando Wait
    
    If Error Then
      Message.Error("Errore durante la distruzione del file: " & Error.Text)
    Else
      Message.Info("Operazione completata!\nIl documento è stato distrutto in modo sicuro e irrecuperabile.")
      TextBoxFile.Text = "" ' Puliamo il campo
    Endif
    
  Endif

End


