  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  ' 2. Identifichiamo il profilo in base all'indice della ComboBox
  If cmbPowerProfile.Index = 0 Then
    sProfilo = "ondemand"  
  Else If cmbPowerProfile.Index = 1 Then
    sProfilo = "performance"
  Else If cmbPowerProfile.Index = 2 Then
    sProfilo = "powersave"
  Else If cmbPowerProfile.Index = 3 Then
    sProfilo = "default" ' <-- La nuova opzione "Origine / Predefinito Debian"
  Else
    Return
  Endif

  txtLog.Text = "[SISTEMA] Richiesta cambio profilo in corso...\n"
  btnApplicaEnergia.Enabled = False

  ' 3. Esecuzione sicura in base al profilo scelto
  If sProfilo = "ondemand" Then
    sComando = "for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo ondemand > \"$f\" 2>/dev/null || echo schedutil > \"$f\"; done"
  Else If sProfilo = "default" Then
    ' Ripristino intelligente: prova prima schedutil (standard moderno Debian) e se fallisce usa ondemand
    sComando = "for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo schedutil > \"$f\" 2>/dev/null || echo ondemand > \"$f\"; done"
  Else
    sComando = "for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo " & sProfilo & " > \"$f\"; done"
  Endif

  ' 4. Esecuzione sfruttando la password salvata (tramite sudo -S)
  Shell "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- sh -c " & Shell(sComando)) Wait

  If Not Error Then
    txtLog.Text &= "\n--- PROFILO APPLICATO CON SUCCESSO ---\n"
    Message.Info("Profilo energetico aggiornato con successo!")
  Else
    txtLog.Text &= "\n[ERRORE] Operazione annullata o non supportata.\n"
    Message.Error("Impossibile modificare il profilo energetico.")
  Endif

  btnApplicaEnergia.Enabled = True
End
