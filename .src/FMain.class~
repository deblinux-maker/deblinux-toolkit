Public Sub btnImpostaDefault_Click()
  Dim sKernelSelezionato As String
  Dim sConfFile As String
  Dim sGrubFile As String
  Dim sPassDecoded As String
  Dim sShellCmd As String
  Dim sVersionePulita As String
  Dim sScriptBash As String
  Dim sTmpFile As String
  
  sKernelSelezionato = lstKernelVecchi.Text
  
  If sKernelSelezionato = "" Then
    Message.Warning("Seleziona prima il kernel dalla lista!")
    Return
  Endif

  If Message.Question("Vuoi impostare il kernel:\n\n" & sKernelSelezionato & "\n\ncome predefinito all'avvio?", "Sì, imposta", "Annulla") <> 1 Then
    Return
  Endif
  
  sConfFile = User.Home &/ ".config/deblinux_toolkit/config.conf"
  sGrubFile = "/etc/default/grub"
  
  If Exist(sConfFile) Then
    Try sPassDecoded = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassDecoded = "" Then
    Message.Warning("Password di root non trovata. Salvala nelle impostazioni generali.")
    Return
  Endif

  txtLog.Text = "Impostazione kernel predefinito in corso..."

  sVersionePulita = Replace(sKernelSelezionato, "linux-image-", "")

  ' 1. Creiamo lo script bash in modo pulito senza conflitti di sintassi di Gambas
  sScriptBash = "#!/bin/bash\n" &
                "KVER=\"" & sVersionePulita & "\"\n" &
                "SUBMENU=\"Advanced options for Debian GNU/Linux 13 (trixie) GNU/Linux\"\n" &
                "ENTRY=$(grep -F \"with Linux $KVER\" /boot/grub/grub.cfg | head -n 1 | cut -d'\"' -f2)\n" &
                "if [ -z \"$ENTRY\" ]; then exit 1; fi\n" &
                "sed -i 's|^GRUB_DEFAULT=.*|GRUB_DEFAULT=\"'\"$SUBMENU\"'>'\"$ENTRY\"'\"|' " & sGrubFile & "\n" &
                "update-grub\n"

  sTmpFile = Temp$()
  File.Save(sTmpFile, sScriptBash)

  ' 2. Eseguiamo lo script con i permessi di root passando la password salvata
  sShellCmd = "echo " & Quote(sPassDecoded) & " | sudo -S bash " & Quote(sTmpFile)
  
  Shell sShellCmd Wait
Shell sShellCmd Wait

  ' Leggiamo cosa è stato effettivamente scritto in /etc/default/grub
  Dim sCheckGrub As String
  Shell "grep '^GRUB_DEFAULT' /etc/default/grub" To sCheckGrub
  txtLog.Text = txtLog.Text & "\nControlliamo /etc/default/grub:\n" & sCheckGrub
  
  

  If Process.LastValue <> 0 Then
    Message.Error("Errore durante l'impostazione del kernel predefinito. Controlla i log.")
    txtLog.Text = "Errore nell'aggiornamento del bootloader."
    Return
  Endif
  ' Pulizia del file temporaneo
  Try Kill sTmpFile

  If Process.LastValue <> 0 Then
    Message.Error("Errore durante l'impostazione del kernel predefinito. Controlla i log.")
    txtLog.Text = "Errore nell'aggiornamento del bootloader."
    Return
  Endif

  Message.Info("Kernel predefinito impostato con successo per la versione: " & sKernelSelezionato & "\nAl prossimo riavvio il sistema userà questo.")
  txtLog.Text = "Bootloader aggiornato correttamente al kernel " & sVersionePulita & "."
End
Public Sub btnPulisciKernel_Click()
  $iInEsecuzione = 1
  Dim sKernel As String
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sScriptBash As String
  Dim sTmpFile As String
  Dim sShellCmd As String
  Dim sOutput As String
  
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword == "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nSalva prima la password di root nelle impostazioni generali.")
    Return
  Endif

  If lstKernelVecchi.Index = -1 Then
    Message.Warning("Seleziona prima un kernel dalla lista!")
    Return
  Endif

  sKernel = lstKernelVecchi.Text

  If Message.Question("Vuoi rimuovere completamente il kernel:\n\n" & sKernel & "?", "Sì, rimuovi", "Annulla") <> 1 Then
    Return
  Endif
  
  txtLog.Clear()
  txtLog.Text = "[SISTEMA] Avvio rimozione in corso per " & sKernel & "...\n"
  Me.Refresh

  ' Script bash strutturato con controlli di errore per ogni singolo passaggio
' Script bash con dpkg --purge per forzare la rimozione pulita del kernel e dei suoi header
  Dim sBaseName As String = Replace(sKernel, "linux-image-", "")
  
  sScriptBash = "#!/bin/bash\n" &
                "export DEBIAN_FRONTEND=noninteractive\n" &
                "echo '=== STEP 1: Rimozione pacchetti con dpkg ==='\n" &
                "dpkg --purge " & sKernel & " linux-headers-" & sBaseName & " linux-headers-" & sBaseName & "-common 2>/dev/null || true\n\n" &
                "echo '=== STEP 2: Pulizia dipendenze orfane ==='\n" &
                "apt-get autoremove --purge -y\n\n" &
                "echo '=== STEP 3: Aggiornamento GRUB ==='\n" &
                "update-grub\n" &
                "echo '=== OPERAZIONE COMPLETATA ==='\n"

  sTmpFile = Temp$()
  File.Save(sTmpFile, sScriptBash)

  sShellCmd = "echo " & Quote(sPassword) & " | sudo -S bash " & Quote(sTmpFile)
  
  Shell sShellCmd To sOutput
  
  Try Kill sTmpFile

  txtLog.Text = txtLog.Text & "\n" & sOutput

  If InStr(sOutput, "ERRORE") > 0 Then
    Message.Error("La rimozione del kernel è fallita. Controlla i log.")
    Return
  Endif

  Message.Info("Kernel rimosso dal disco con successo!")
  txtLog.Text = txtLog.Text & "\n--- OPERAZIONE CONCLUSA CON SUCCESSO ---"
  
  ' Aggiorna la lista dei kernel nel toolkit se hai la funzione
  ' CaricaKernel()
  CaricaKernelManager()
  $iInEsecuzione = 0
End

Public Sub btnPulisci2_Click()
  $iInEsecuzione = 1
  Dim sCartellaScelta As String
  Dim sRiga As String
  Dim iContatore As Integer = 0

  ' SE IL PULSANTE È "Conferma Eliminazione", CANCELLA SOLO QUELLI SPUNTATI
  If btnPulisci2.Text = ("Conferma Eliminazione") Then
    If Message.Question("Sei sicuro di voler eliminare definitivamente gli elementi selezionati?", "Annulla", "Elimina Ora") = 2 Then
      
      For iContatore = 0 To GridView1.Rows.Max
        If GridView1[iContatore, 0].Text = "[X]" Then
          Try Kill GridView1[iContatore, 1].Text 
        Endif
      Next

      Message.Info("Pulizia completata!")
      GridView1.Clear
      btnPulisci2.Text = ("Analizza")
    Endif
    Return
  Endif

  ' 1. SCEGLI LA CARTELLA DA ANALIZZARE (Parte sempre dalla Home)
  Dialog.Title = ("Seleziona la cartella da analizzare (solo all'interno della tua Home)")
  Dialog.Path = User.Home 
  If Dialog.SelectDirectory() Then Return 
  
  sCartellaScelta = Dialog.Path

  ' --- CONTROLLO RIGOROSO: ACCETTA SOLO LA HOME O SOTTOCARTELLE ---
  ' Verifichiamo che il percorso inizi esattamente con la cartella Home dell'utente
  If InStr(sCartellaScelta, User.Home) <> 1 Then
    Message.Error("Non è possibile cercare nelle cartelle di sistema! Puoi selezionare solo cartelle all'interno della tua Home.")
    Return
  Endif
  ' -----------------------------------------------------------------

  ' 2. PREPARIAMO LA GRIDVIEW
  GridView1.Clear
  GridView1.Background = &H1E2837 ' Colore scuro del tuo tema
  GridView1.Foreground = Color.White
  GridView1.Columns.Count = 2      ' Creiamo subito le 2 colonne
  GridView1.Columns[0].Width = 40
  GridView1.Columns[1].Width = 500
  GridView1.Columns[0].Text = "OK"
  GridView1.Columns[1].Text = ("Percorso Elemento Vuoto")

  ' 3. ESEGUIAMO LA RICERCA IN BASE ALLE SCELTE FATTE CON I CHECKBOX SUL FORM
  Dim aLinee As String[] = New String[]
  Dim sRisultatoFile As String
  Dim sRisultatoDir As String

  ' Se l'utente ha spuntato di cercare i file a 0 byte
  If chkFileVuoti.Value = True Then
    Dim sComandoFile As String = "find " & Shell(sCartellaScelta) & " -type f -size 0 -not -path '*/.*' -not -path '*/config*' 2>/dev/null"
    Shell sComandoFile To sRisultatoFile
    If sRisultatoFile <> "" Then aLinee.Add(sRisultatoFile)
  Endif

  ' Se l'utente ha spuntato di cercare le cartelle vuote
  If chkCartelleVuote.Value = True Then
    Dim sComandoDir As String = "find " & Shell(sCartellaScelta) & " -type d -empty -not -path '*/.*' -not -path '*/config*' 2>/dev/null"
    Shell sComandoDir To sRisultatoDir
    If sRisultatoDir <> "" Then aLinee.Add(sRisultatoDir)
  Endif

  ' 4. RIEMPIAMO LA TABELLA
  For Each sRiga In aLinee
    For Each SubRiga As String In Split(sRiga, "\n")
      If SubRiga <> "" And SubRiga <> sCartellaScelta Then
        iContatore += 1
        GridView1.Rows.Count = iContatore
        
        GridView1[iContatore - 1, 0].Text = "[X]"
        GridView1[iContatore - 1, 0].Alignment = Align.Center
        GridView1[iContatore - 1, 1].Text = SubRiga
      Endif
    Next
  Next

  If iContatore > 0 Then
    Message.Info("Trovati " & iContatore & " elementi.\n\nFai clic sulla colonna 'OK' per deselezionare quelli che non vuoi cancellare!")
    btnPulisci2.Text = ("Conferma Eliminazione")
  Else
    Message.Info("Nessun file a 0 byte o cartella vuota trovati in questa cartella.")
  Endif
  $iInEsecuzione = 0
End

