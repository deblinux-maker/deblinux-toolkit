  ' Esegue il comando reindirizzando l'output su file temporaneo tramite SHELL in background
  sComando = "printf '%s\n' " & Shell(sPassword) & " | sudo -S -- stress-ng --cpu 0 --timeout 30s --metrics-brief > " & Shell(sFileLog) & " 2>&1"
  hProcess = Shell "/bin/sh -c " & Shell(sComando)
  
  ' Avvia il timer per controllare la fine del processo
