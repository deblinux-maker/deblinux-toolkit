' --- PULSANTE 1: CREA PUNTO DI RIPRISTINO ---
Public Sub btnCreaSnapshot_Click()
$iInEsecuzione = 1
' 0. Controllo preliminare: impediamo l'esecuzione in modalità Live
  If Exist("/run/live") Or Exist("/lib/live/mount") Then
    Message.Warning("Questa funzione non è disponibile in modalità Live.\n\nInstalla Deblinux sul disco fisso per poter creare punti di ripristino.")
    Return
  Endif
  
  Dim sScript As String
  Dim sDest As String = "/media/backup/deblinux_snapshots"
  Dim sConfFile As String = User.Home &/ ".config/deblinux_toolkit/config.conf"
  Dim sPassword As String
  Dim sComando As String
  
  ' 1. Verifichiamo subito se la password di amministrazione è salvata
  If Exist(sConfFile) Then
    Try sPassword = FromBase64$(File.Load(sConfFile))
  Endif

  If sPassword = "" Then
    Message.Warning("Questa funzione richiede i privilegi di amministratore.\n\nPer motivi di sicurezza e stabilità, è necessario salvare prima la password di root nelle impostazioni generali del programma.")
    Return
  Endif

  btnCreaSnapshot.Enabled = False
  btnGestisciSnapshot.Enabled = False
  btnAnnulla.Enabled = True  
  txtLog.Insert("\n--- Creazione punto di ripristino in corso... Attendere. ---\n")
  
  sScript = Temp$()
  File.Save(sScript, "#!/bin/bash\n" &
                     "DEST=\"" & sDest & "/snapshot_$(date +%Y%m%d_%H%M%S)\"\n" &
                     "echo 'Creazione cartella di destinazione...'\n" &
                     "mkdir -p \"$DEST\"\n" &
                     "echo 'Avvio copia dei file di sistema con rsync (potrebbe impiegare qualche minuto)...'\n" &
                     "# Eseguiamo rsync e salviamo il codice di uscita\n" &
                     "rsync -aAXv / \"$DEST\" --exclude=\"/dev/*\" --exclude=\"/proc/*\" --exclude=\"/sys/*\" --exclude=\"/tmp/*\" --exclude=\"/run/*\" --exclude=\"/mnt/*\" --exclude=\"/media/*\" --exclude=\"/lost+found\"\n" &
                     "RET=$?\n" &
                     "if [ $RET -eq 0 ]; then\n" &
                     "    echo 'Punto di ripristino completato con successo!'\n" &
                     "    exit 0\n" &
                     "else\n" &
                     "    echo 'Operazione interrotta o fallita. Pulizia della cartella incompleta...'\n" &
                     "    rm -rf \"$DEST\"\n" &
                     "    exit 1\n" &
                     "fi")
                     
  Exec ["chmod", "+x", sScript]
  Wait 0.2
  
  ' 2. Avvio del processo sfruttando la password salvata (tramite sudo -S)
  sComando = "/bin/sh -c " & Shell("printf '%s\n' " & Shell(sPassword) & " | sudo -S -- /bin/bash " & Shell(sScript))
  Try $hProc = Shell sComando For Read Write As "CreaSnap"
  
  If Error Or If Not $hProc Then
    Message.Error("Impossibile avviare il processo di creazione dello snapshot.")
    btnCreaSnapshot.Enabled = True
    btnGestisciSnapshot.Enabled = True
    btnAnnulla.Enabled = False
    Return
  Endif
  $iInEsecuzione = 0
End

' --- GESTIONE DELLA FINE DEL PROCESSO ---
Public Sub CreaSnap_Kill()
  
  ' Se il processo è già stato azzerato (es. perché abbiamo premuto Annulla), usciamo subito
  If Not $hProc Then Return
  
  If $hProc.Value = 0 Then
    txtLog.Insert("\n--- Operazione terminata con successo! ---\n")
    Message.Info("Punto di ripristino creato correttamente.")
  Else
    txtLog.Insert("\n--- Errore o operazione interrotta. ---\n")
    Message.Error("Si è verificato un errore durante la creazione dello snapshot.")
  Endif
  
  btnCreaSnapshot.Enabled = True
  $hProc = Null
End

