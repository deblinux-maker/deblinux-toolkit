  Shell "systemctl is-enabled ModemManager.service smartmontools.service NetworkManager-wait-online.service 2>/dev/null" To sOutput
  
  ' Se i servizi sono disattivati (quindi ottimizzati)
  If InStr(sOutput, "disabled") > 0 And InStr(sOutput, "enabled") = 0 Then
    CheckBox1.Value = True  
